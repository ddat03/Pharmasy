---
// Pagina 404 real. Sin esta, Cloudflare Pages cae a su fallback de "Single
// Page Application": sirve el home (index.html) con status 200 para
// CUALQUIER url que no exista, en vez de un 404 de verdad. Confirmado en
// vivo (2026-09): "esto-no-existe-jamas-xyz123" devolvia 200 con el
// contenido del home -- Google podia terminar indexando enlaces rotos como
// si fueran paginas validas, con contenido duplicado del home. Astro
// reconoce este nombre de archivo de forma especial: genera dist/404.html,
// y Cloudflare Pages lo detecta solo y lo sirve con status 404 real para
// cualquier ruta sin coincidencia -- no requiere tocar la configuracion del
// proyecto en el dashboard.
import Layout from "../layouts/Layout.astro";
import { CATEGORIAS } from "../lib/categorias";
---

<Layout
  title="Página no encontrada | Farma Precios Ecuador"
  description="Esta página no existe o cambió de dirección. Buscá tu medicamento o volvé al inicio."
>
  <div class="col">
    <p class="codigo">404</p>
    <h1>Esta página no existe</h1>
    <p class="prose lead">
      El enlace puede estar roto o el medicamento cambió de dirección — a veces pasa cuando fusionamos dos fichas
      del mismo producto. Probá buscarlo de nuevo o volvé al inicio.
    </p>

    <a class="cta" href="/">Ir al buscador</a>

    <p class="field-label">O explorá por categoría</p>
    <div class="grid">
      {
        CATEGORIAS.map((c) => (
          <a class="fila" href={`/categoria/${c.slug}/`}>
            {c.nombre}
          </a>
        ))
      }
      <a class="fila" href="/marcas/">
        Marcas
      </a>
    </div>
  </div>
</Layout>

<style>
  .codigo {
    margin: 1.5rem 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--stamp);
  }
  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .lead {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 1.75rem;
  }
  .cta {
    display: inline-block;
    background: var(--stamp);
    color: var(--paper-raised);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    margin-bottom: 2.75rem;
    transition: background-color 140ms var(--ease-print);
  }
  .cta:hover {
    background: var(--stamp-dark);
  }
  .field-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0 2.5rem;
    border-top: 1px solid var(--ink-faint);
    max-width: 62ch;
  }
  .fila {
    padding: 0.7rem 0.15rem;
    border-bottom: 1px solid var(--ink-faint);
    text-decoration: none;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .fila:hover {
    color: var(--stamp);
  }
</style>
