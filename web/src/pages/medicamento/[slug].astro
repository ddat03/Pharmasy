---
// Página por medicamento, pre-generada en el build. Tabla comparativa de
// las cadenas que lo venden, aviso de precio techo si aplica, link al
// grupo de equivalentes por principio activo.
import Layout from "../../layouts/Layout.astro";
import {
  getAllDrugs,
  getPricesForDrug,
  slugifyPrincipio,
  PHARMACY_LABELS,
  type Drug,
  type LatestPriceRow,
} from "../../lib/supabase";

export async function getStaticPaths() {
  const drugs = await getAllDrugs();
  return Promise.all(
    drugs.map(async (drug) => ({
      params: { slug: drug.slug },
      props: { drug, prices: await getPricesForDrug(drug.id) },
    })),
  );
}

interface Props {
  drug: Drug;
  prices: LatestPriceRow[];
}
const { drug, prices } = Astro.props;

const nombre = [drug.principio_activo, drug.concentracion, drug.forma_farmaceutica].filter(Boolean).join(" ");
const pricedRows = prices.filter((p) => p.precio_usd != null);
const cheapestId =
  pricedRows.length > 0
    ? pricedRows.reduce((min, r) => ((r.precio_usd ?? Infinity) < (min.precio_usd ?? Infinity) ? r : min)).pharmacy_product_id
    : null;
// OJO: precio_techo_usd es por unidad (fijado así por el Consejo Nacional
// de Fijación de Precios) y precio_usd es por presentación completa (caja
// / frasco) — todavía no son comparables directamente porque no extraemos
// de forma confiable cuántas unidades trae cada presentación. Ver
// Boveda Farmacia/Conceptos/Precio techo.md. Por eso NO se calcula ni
// muestra un aviso de "sobreprecio": hacerlo sin normalizar por unidad
// acusaría erróneamente a farmacias que en realidad cumplen.
const techo = drug.precio_techo_usd;

function formatPrice(value: number | null): string {
  return value == null ? "—" : `$${value.toFixed(2)}`;
}
---

<Layout title={`${nombre} — precios en Ecuador | Farma Precios Ecuador`}>
  <p class="breadcrumb">
    <a href="/">Buscador</a> ·
    <a href={`/principio/${slugifyPrincipio(drug.principio_activo)}`}>{drug.principio_activo}</a>
  </p>
  <h1>{nombre}</h1>
  {drug.presentacion && <p class="subtitle">{drug.presentacion}</p>}

  {
    techo != null && (
      <p class="techo-info">
        Precio techo oficial (por unidad): <strong>{formatPrice(techo)}</strong>. Los precios de abajo son por
        presentación completa (caja/frasco), así que no son directamente comparables contra este valor todavía.
      </p>
    )
  }

  {
    prices.length === 0 ? (
      <p class="status">Todavía no tenemos precios registrados para este medicamento.</p>
    ) : (
      <div class="price-list">
        {prices.map((row) => {
          const isCheapest = row.pharmacy_product_id === cheapestId;
          return (
            <article class={`card ${isCheapest ? "cheapest" : ""}`}>
              {isCheapest && <span class="badge">Mejor precio</span>}
              <div class="card-main">
                <h3>{PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy}</h3>
                <p class="pharmacy">{row.nombre_en_tienda}</p>
              </div>
              <div class="card-side">
                <p class="price">{formatPrice(row.precio_usd)}</p>
                <p class={`stock ${row.en_stock === true ? "ok" : row.en_stock === false ? "danger" : "muted"}`}>
                  {row.en_stock === true ? "En stock" : row.en_stock === false ? "Sin stock" : "Disponibilidad no confirmada"}
                </p>
                {row.url && (
                  <a class="cta" href={row.url} target="_blank" rel="noopener">
                    Ver en tienda
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )
  }

  <p class="generic-note">
    {drug.es_generico ? "Este es un medicamento genérico." : "Este es un medicamento de marca."} Si buscas
    equivalentes con el mismo principio activo, revisa la{" "}
    <a href={`/principio/${slugifyPrincipio(drug.principio_activo)}`}>página de {drug.principio_activo}</a> —
    mismo principio activo, consulte a su médico o farmacéutico antes de sustituir un medicamento.
  </p>
</Layout>

<style>
  .breadcrumb {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--accent-dark);
  }
  h1 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.1rem;
  }
  .subtitle {
    color: var(--muted);
    margin-top: 0;
  }
  .techo-info {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .alert-techo {
    background: var(--danger-bg);
    color: var(--danger);
    border: 1px solid #f3c6c2;
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    margin: 0.75rem 0;
  }
  .price-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    position: relative;
  }
  .card.cheapest {
    border-color: var(--ok);
  }
  .badge {
    position: absolute;
    top: -0.6rem;
    left: 0.9rem;
    background: var(--ok);
    color: #fff;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
  .card-main h3 {
    margin: 0 0 0.15rem;
    font-size: 1rem;
  }
  .pharmacy {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .over-techo {
    color: var(--danger);
    font-size: 0.78rem;
    margin: 0.25rem 0 0;
  }
  .card-side {
    text-align: right;
    min-width: 140px;
  }
  .price {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-dark);
  }
  .stock {
    margin: 0.15rem 0 0.4rem;
    font-size: 0.8rem;
  }
  .stock.ok {
    color: var(--ok);
  }
  .stock.danger {
    color: var(--danger);
  }
  .stock.muted {
    color: var(--muted);
  }
  .cta {
    display: inline-block;
    font-size: 0.82rem;
    color: #fff;
    background: var(--accent);
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .generic-note {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    color: var(--muted);
    background: #f0f4fa;
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
  }
  .generic-note a {
    color: var(--accent-dark);
  }
  .status {
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .card {
      flex-direction: column;
    }
    .card-side {
      text-align: left;
    }
  }
</style>
