---
// Página por medicamento, pre-generada en el build. Ledger comparativo de
// las cadenas que lo venden, precio techo oficial mostrado como línea de
// regulación aparte (nunca comparado contra el precio de farmacia), link
// al grupo de equivalentes por principio activo.
import Layout from "../../layouts/Layout.astro";
import {
  getAllDrugs,
  getAllPricedProductsByDrug,
  getResumen,
  formatFechaLarga,
  slugifyPrincipio,
  PHARMACY_LABELS,
  PHARMACY_LOGOS,
  type Drug,
  type LatestPriceRow,
} from "../../lib/supabase";
import { categoriaDe, categoriaMeta } from "../../lib/categorias";

type Vecino = { slug: string; nombre: string; desde: number | null };

export async function getStaticPaths() {
  const [drugs, pricesByDrug] = await Promise.all([getAllDrugs(), getAllPricedProductsByDrug()]);

  // Precio comparable mas bajo de cada medicamento, para poder mostrar
  // "desde $X" en los enlaces de navegacion sin volver a consultar.
  const desdePorDrug = new Map<string, number | null>();
  for (const d of drugs) {
    const comparables = (pricesByDrug.get(d.id) ?? []).filter((p) => p.precio_usd != null && !p.precio_por_unidad);
    desdePorDrug.set(d.id, comparables.length ? Math.min(...comparables.map((p) => p.precio_usd as number)) : null);
  }

  const porPrincipio = new Map<string, Drug[]>();
  const porCategoria = new Map<string, Drug[]>();
  for (const d of drugs) {
    const pk = slugifyPrincipio(d.principio_activo);
    if (!porPrincipio.has(pk)) porPrincipio.set(pk, []);
    porPrincipio.get(pk)!.push(d);
    const cat = categoriaDe(d.principio_activo);
    if (cat) {
      if (!porCategoria.has(cat)) porCategoria.set(cat, []);
      porCategoria.get(cat)!.push(d);
    }
  }

  const aVecino = (d: Drug): Vecino => ({
    slug: d.slug,
    nombre: [d.principio_activo, d.concentracion, d.forma_farmaceutica].filter(Boolean).join(" "),
    desde: desdePorDrug.get(d.id) ?? null,
  });

  return drugs.map((drug) => {
    const catSlug = categoriaDe(drug.principio_activo);

    // Mismo principio activo, otra concentracion o forma.
    const presentaciones = (porPrincipio.get(slugifyPrincipio(drug.principio_activo)) ?? [])
      .filter((d) => d.slug !== drug.slug)
      .map(aVecino)
      .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"))
      .slice(0, 8);

    // Misma categoria, distinto principio activo, y solo los que tienen
    // precio: un enlace a una pagina sin precios no le sirve a nadie.
    const relacionados = (catSlug ? (porCategoria.get(catSlug) ?? []) : [])
      .filter((d) => d.principio_activo !== drug.principio_activo)
      .map(aVecino)
      .filter((v) => v.desde != null)
      .sort((a, b) => (a.desde as number) - (b.desde as number))
      .slice(0, 8);

    return {
      params: { slug: drug.slug },
      props: { drug, prices: pricesByDrug.get(drug.id) ?? [], presentaciones, relacionados, catSlug },
    };
  });
}

interface Props {
  drug: Drug;
  prices: LatestPriceRow[];
  presentaciones: Vecino[];
  relacionados: Vecino[];
  catSlug: string | null;
}
const { drug, prices, presentaciones, relacionados, catSlug } = Astro.props;
const cat = catSlug ? categoriaMeta(catSlug) : undefined;

// Fecha del ultimo scrapeo global. Una fila con fecha anterior es un precio
// que no se pudo reconfirmar hoy (pasa con Farmacias Economicas, cuya
// vitrina en Rappi rota que productos muestra): se rotula en la fila en vez
// de dejarlo pasar por un precio de hoy.
const resumen = await getResumen().catch(() => ({ fecha: null, productosHoy: null, conPrecioTecho: null }));
const fechaGlobal = resumen.fecha;

const nombre = [drug.principio_activo, drug.concentracion, drug.forma_farmaceutica].filter(Boolean).join(" ");
const pricedRows = prices.filter((p) => p.precio_usd != null);
// Filas con precio_por_unidad (ej. Medicity marca productos "esFraccionado"
// cuya API devuelve precio por tableta suelta, no por la caja) quedan fuera
// del cálculo de "mejor precio": comparar un precio por unidad contra el
// precio de caja de otra farmacia sería la misma comparación inventada que
// el sitio se niega a hacer. Ver Boveda Farmacia/Conceptos/Precio techo.md.
const comparableRows = pricedRows.filter((p) => !p.precio_por_unidad);
const cheapestId =
  comparableRows.length > 0
    ? comparableRows.reduce((min, r) => ((r.precio_usd ?? Infinity) < (min.precio_usd ?? Infinity) ? r : min)).pharmacy_product_id
    : null;
// OJO: precio_techo_usd es por unidad (fijado así por el Consejo Nacional
// de Fijación de Precios) y precio_usd es por presentación completa (caja
// / frasco) — todavía no son comparables directamente porque no extraemos
// de forma confiable cuántas unidades trae cada presentación. Ver
// Boveda Farmacia/Conceptos/Precio techo.md. Por eso NO se calcula ni
// muestra un aviso de "sobreprecio": hacerlo sin normalizar por unidad
// acusaría erróneamente a farmacias que en realidad cumplen. Se muestra
// como su propia línea de regulación, igual que el IVA aparece en una
// factura real: presente, rotulado, nunca mezclado con el precio del
// vendedor.
const techo = drug.precio_techo_usd;

function formatPrice(value: number | null): string {
  if (value == null) return "—";
  const [whole, cents] = value.toFixed(2).split(".");
  return `$${whole}.${cents}`;
}

const MESES = [
  "enero", "febrero", "marzo", "abril", "mayo", "junio",
  "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre",
];
const now = new Date();
const mesAnio = `${MESES[now.getMonth()]} ${now.getFullYear()}`;
const seoTitle = `Precio de ${nombre} en Ecuador — comparación ${mesAnio} | Farma Precios Ecuador`;
const desdeRows = comparableRows.length > 0 ? comparableRows : pricedRows;
const seoDescription =
  pricedRows.length > 0
    ? `Compara el precio de ${nombre} en ${pricedRows.length} ${pricedRows.length === 1 ? "farmacia" : "farmacias"} de Ecuador. Desde ${formatPrice(Math.min(...desdeRows.map((p) => p.precio_usd as number)))}.`
    : `Precio de ${nombre} en farmacias de Ecuador: Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: nombre,
  description: drug.presentacion ?? undefined,
  ...(drug.laboratorio ? { brand: { "@type": "Brand", name: drug.laboratorio } } : {}),
  ...(pricedRows.length > 0
    ? {
        offers: pricedRows.map((row) => ({
          "@type": "Offer",
          price: row.precio_usd,
          priceCurrency: "USD",
          availability:
            row.en_stock === true
              ? "https://schema.org/InStock"
              : row.en_stock === false
                ? "https://schema.org/OutOfStock"
                : "https://schema.org/LimitedAvailability",
          url: row.url ?? undefined,
          seller: { "@type": "Organization", name: PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy },
        })),
      }
    : {}),
};
---

<Layout title={seoTitle} description={seoDescription} structuredData={structuredData}>
  <div class="col">
  <p class="breadcrumb">
    <a href="/">Buscador</a> <span aria-hidden="true">·</span>
    {cat && (
      <>
        <a href={`/categoria/${cat.slug}`}>{cat.nombre}</a> <span aria-hidden="true">·</span>
      </>
    )}
    <a href={`/principio/${slugifyPrincipio(drug.principio_activo)}`}>{drug.principio_activo}</a>
  </p>
  <h1>{nombre}</h1>
  {drug.presentacion && <p class="subtitle">{drug.presentacion}</p>}

  <!-- AD SLOT: banner superior, debajo del título — ver Layout.astro para cómo activar -->

  {
    techo != null && (
      <div class="reg-line">
        <span class="reg-label">Precio techo oficial · Consejo Nacional de Fijación de Precios (por unidad)</span>
        <span class="reg-value">{formatPrice(techo)}</span>
        <p class="reg-note">
          Los precios de abajo son por presentación completa (caja/frasco) — no son directamente comparables contra
          este valor todavía.
        </p>
      </div>
    )
  }

  <div class="tear" aria-hidden="true"></div>

  {
    prices.length === 0 ? (
      <p class="status">Todavía no tenemos precios registrados para este medicamento.</p>
    ) : (
      <div class="ledger">
        {prices.map((row, i) => {
          const isCheapest = row.pharmacy_product_id === cheapestId;
          const logo = PHARMACY_LOGOS[row.pharmacy];
          const delay = Math.min(i * 45, 360);
          return (
            <article class={`ledger-row print-in ${isCheapest ? "is-cheapest" : ""}`} style={`animation-delay:${delay}ms`}>
              {isCheapest && <span class="stamp-badge">Mejor precio</span>}
              <div class="ledger-mark">{logo && <img src={logo} alt={PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy} loading="lazy" />}</div>
              <div class="ledger-main">
                <p class="ledger-name">{PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy}</p>
                <p class="ledger-sub">{row.nombre_en_tienda}</p>
                <p class={`ledger-stock ${row.en_stock === true ? "ok" : row.en_stock === false ? "danger" : "muted"}`}>
                  {row.en_stock === true ? "En stock" : row.en_stock === false ? "Sin stock" : "Disponibilidad no confirmada"}
                </p>
              </div>
              <div class="ledger-side">
                <p class="ledger-price">
                  <span class="odometer roll-in">{formatPrice(row.precio_usd)}</span>
                </p>
                {row.precio_por_unidad && <p class="ledger-unit-note">precio por unidad, no por caja</p>}
                {fechaGlobal && row.fecha !== fechaGlobal && (
                  <p class="ledger-stale">precio del {formatFechaLarga(row.fecha)}</p>
                )}
                {row.url && (
                  <a class="ledger-cta" href={row.url} target="_blank" rel="noopener">
                    Ver en tienda
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )
  }

  <p class="generic-note">
    {drug.es_generico ? "Este es un medicamento genérico." : "Este es un medicamento de marca."} Si buscas
    equivalentes con el mismo principio activo, revisa la{" "}
    <a href={`/principio/${slugifyPrincipio(drug.principio_activo)}`}>página de {drug.principio_activo}</a> —
    mismo principio activo, consulte a su médico o farmacéutico antes de sustituir un medicamento.
  </p>

  {
    presentaciones.length > 0 && (
      <section class="vecinos">
        <p class="field-label">Otras presentaciones de {drug.principio_activo}</p>
        <div class="vecinos-grid">
          {presentaciones.map((v) => (
            <a class="vecino" href={`/medicamento/${v.slug}`}>
              <span class="vecino-nombre">{v.nombre}</span>
              <span class="vecino-precio">{v.desde != null ? `desde ${formatPrice(v.desde)}` : "sin precio"}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    relacionados.length > 0 && cat && (
      <section class="vecinos">
        <p class="field-label">
          Más de {cat.nombre} · <a href={`/categoria/${cat.slug}`}>ver todo</a>
        </p>
        <div class="vecinos-grid">
          {relacionados.map((v) => (
            <a class="vecino" href={`/medicamento/${v.slug}`} style={`--cat-color:${cat.color}`}>
              <span class="vecino-nombre">{v.nombre}</span>
              <span class="vecino-precio">desde {formatPrice(v.desde)}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- AD SLOT: debajo de la nota de equivalencia genérica — ver Layout.astro para cómo activar -->
  </div>
</Layout>

<style>
  .field-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }
  .field-label a {
    color: var(--stamp);
  }

  /* Precio que no se pudo reconfirmar en el ultimo scrapeo. Se rotula en la
     fila: el encabezado dice "precios del <hoy>" y sin esto una fila vieja
     se ve identica a una fresca. */
  .ledger-stale {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--warn);
    background: var(--warn-bg);
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
    display: inline-block;
  }

  .vecinos {
    margin-top: 2.5rem;
  }
  .vecinos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0 2rem;
    border-top: 1px solid var(--ink-faint);
  }
  .vecino {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem;
    padding: 0.7rem 0.15rem;
    border-bottom: 1px solid var(--ink-faint);
    text-decoration: none;
    color: var(--ink);
  }
  .vecino-nombre {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
    border-bottom: 1px solid transparent;
  }
  .vecino:hover .vecino-nombre {
    border-bottom-color: var(--cat-color, var(--ink));
  }
  .vecino-precio {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .breadcrumb {
    font-size: 0.8rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }
  .breadcrumb a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--ink-faint);
    text-underline-offset: 3px;
  }
  .breadcrumb a:hover {
    color: var(--stamp-dark);
  }
  h1 {
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0.3rem 0 0.15rem;
  }
  .subtitle {
    color: var(--ink-muted);
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
  }

  .reg-line {
    margin-top: 1rem;
    border: 1px dashed var(--ink-faint);
    border-radius: 3px;
    padding: 0.75rem 0.95rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    background: var(--paper-raised);
  }
  .reg-label {
    font-size: 0.72rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .reg-value {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--stamp-dark);
    font-variant-numeric: tabular-nums;
  }
  .reg-note {
    grid-column: 1 / -1;
    margin: 0.15rem 0 0;
    font-size: 0.74rem;
    color: var(--ink-muted);
  }

  .generic-note {
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--ink-muted);
    background: var(--paper-raised);
    border: 1px solid var(--ink-faint);
    border-radius: 3px;
    padding: 0.8rem 0.95rem;
  }
  .generic-note a {
    color: var(--stamp-dark);
  }
</style>
