---
// Página por medicamento, pre-generada en el build. Tabla comparativa de
// las cadenas que lo venden, aviso de precio techo si aplica, link al
// grupo de equivalentes por principio activo.
import Layout from "../../layouts/Layout.astro";
import {
  getAllDrugs,
  getPricesForDrug,
  slugifyPrincipio,
  PHARMACY_LABELS,
  PHARMACY_COLORS,
  pharmacyInitials,
  type Drug,
  type LatestPriceRow,
} from "../../lib/supabase";

export async function getStaticPaths() {
  const drugs = await getAllDrugs();
  return Promise.all(
    drugs.map(async (drug) => ({
      params: { slug: drug.slug },
      props: { drug, prices: await getPricesForDrug(drug.id) },
    })),
  );
}

interface Props {
  drug: Drug;
  prices: LatestPriceRow[];
}
const { drug, prices } = Astro.props;

const nombre = [drug.principio_activo, drug.concentracion, drug.forma_farmaceutica].filter(Boolean).join(" ");
const pricedRows = prices.filter((p) => p.precio_usd != null);
const cheapestId =
  pricedRows.length > 0
    ? pricedRows.reduce((min, r) => ((r.precio_usd ?? Infinity) < (min.precio_usd ?? Infinity) ? r : min)).pharmacy_product_id
    : null;
// OJO: precio_techo_usd es por unidad (fijado así por el Consejo Nacional
// de Fijación de Precios) y precio_usd es por presentación completa (caja
// / frasco) — todavía no son comparables directamente porque no extraemos
// de forma confiable cuántas unidades trae cada presentación. Ver
// Boveda Farmacia/Conceptos/Precio techo.md. Por eso NO se calcula ni
// muestra un aviso de "sobreprecio": hacerlo sin normalizar por unidad
// acusaría erróneamente a farmacias que en realidad cumplen.
const techo = drug.precio_techo_usd;

function formatPrice(value: number | null): string {
  return value == null ? "—" : `$${value.toFixed(2)}`;
}

const MESES = [
  "enero", "febrero", "marzo", "abril", "mayo", "junio",
  "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre",
];
const now = new Date();
const mesAnio = `${MESES[now.getMonth()]} ${now.getFullYear()}`;
const seoTitle = `Precio de ${nombre} en Ecuador — comparación ${mesAnio} | Farma Precios Ecuador`;
const seoDescription =
  pricedRows.length > 0
    ? `Compara el precio de ${nombre} en ${pricedRows.length} ${pricedRows.length === 1 ? "farmacia" : "farmacias"} de Ecuador. Desde ${formatPrice(Math.min(...pricedRows.map((p) => p.precio_usd as number)))}.`
    : `Precio de ${nombre} en farmacias de Ecuador: Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: nombre,
  description: drug.presentacion ?? undefined,
  ...(drug.laboratorio ? { brand: { "@type": "Brand", name: drug.laboratorio } } : {}),
  ...(pricedRows.length > 0
    ? {
        offers: pricedRows.map((row) => ({
          "@type": "Offer",
          price: row.precio_usd,
          priceCurrency: "USD",
          availability:
            row.en_stock === true
              ? "https://schema.org/InStock"
              : row.en_stock === false
                ? "https://schema.org/OutOfStock"
                : "https://schema.org/LimitedAvailability",
          url: row.url ?? undefined,
          seller: { "@type": "Organization", name: PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy },
        })),
      }
    : {}),
};
---

<Layout title={seoTitle} description={seoDescription} structuredData={structuredData}>
  <p class="breadcrumb">
    <a href="/">Buscador</a> ·
    <a href={`/principio/${slugifyPrincipio(drug.principio_activo)}`}>{drug.principio_activo}</a>
  </p>
  <h1>{nombre}</h1>
  {drug.presentacion && <p class="subtitle">{drug.presentacion}</p>}

  <!-- AD SLOT: banner superior, debajo del título — ver Layout.astro para cómo activar -->


  {
    techo != null && (
      <p class="techo-info">
        Precio techo oficial (por unidad): <strong>{formatPrice(techo)}</strong>. Los precios de abajo son por
        presentación completa (caja/frasco), así que no son directamente comparables contra este valor todavía.
      </p>
    )
  }

  {
    prices.length === 0 ? (
      <p class="status">Todavía no tenemos precios registrados para este medicamento.</p>
    ) : (
      <div class="price-list">
        {prices.map((row) => {
          const isCheapest = row.pharmacy_product_id === cheapestId;
          return (
            <article class={`price-card ${isCheapest ? "cheapest" : ""}`}>
              {isCheapest && <span class="price-card-badge">Mejor precio</span>}
              <div class="price-card-main">
                <div class="pharmacy-avatar" style={`background:${PHARMACY_COLORS[row.pharmacy] ?? "#667085"}`}>
                  {pharmacyInitials(row.pharmacy)}
                </div>
                <div class="price-card-text">
                  <h3>{PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy}</h3>
                  <p class="pharmacy-name">{row.nombre_en_tienda}</p>
                  <p class={`stock ${row.en_stock === true ? "ok" : row.en_stock === false ? "danger" : "muted"}`}>
                    {row.en_stock === true ? "En stock" : row.en_stock === false ? "Sin stock" : "Disponibilidad no confirmada"}
                  </p>
                </div>
              </div>
              <div class="price-card-side">
                <p class="price">{formatPrice(row.precio_usd)}</p>
                {row.url && (
                  <a class="cta" href={row.url} target="_blank" rel="noopener">
                    Ver en tienda
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )
  }

  <p class="generic-note">
    {drug.es_generico ? "Este es un medicamento genérico." : "Este es un medicamento de marca."} Si buscas
    equivalentes con el mismo principio activo, revisa la{" "}
    <a href={`/principio/${slugifyPrincipio(drug.principio_activo)}`}>página de {drug.principio_activo}</a> —
    mismo principio activo, consulte a su médico o farmacéutico antes de sustituir un medicamento.
  </p>

  <!-- AD SLOT: debajo de la nota de equivalencia genérica — ver Layout.astro para cómo activar -->
</Layout>

<style>
  .breadcrumb {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--accent-dark);
  }
  h1 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.1rem;
  }
  .subtitle {
    color: var(--muted);
    margin-top: 0;
  }
  .techo-info {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .alert-techo {
    background: var(--danger-bg);
    color: var(--danger);
    border: 1px solid #f3c6c2;
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    margin: 0.75rem 0;
  }
  .price-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .generic-note {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    color: var(--muted);
    background: #f0f4fa;
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
  }
  .generic-note a {
    color: var(--accent-dark);
  }
</style>
