---
// Índice de marcas. Sin esta página las de marca serían huérfanas: nada las
// enlazaría y Google tardaría mucho más en encontrarlas.
import Layout from "../layouts/Layout.astro";
import { getMarcas } from "../lib/marcas";

const marcas = await getMarcas();
const comparables = marcas.filter((m) => m.cadenas.length > 1);
const unaSola = marcas.filter((m) => m.cadenas.length === 1);

function formatPrice(value: number | null): string {
  if (value == null) return "—";
  const [whole, cents] = value.toFixed(2).split(".");
  return `$${whole}.${cents}`;
}

// Adelanto al pasar el mouse: hasta 6 presentaciones reales de la marca
// (getMarcas() ya las deja ordenadas por precio). No hay pagina individual
// por producto, asi que cada item del adelanto lleva a la misma pagina de
// la marca que el "Ver todo" -- es informativo, no un destino distinto.
function previewDeMarca(m: (typeof marcas)[number]) {
  return m.productos.slice(0, 6).map((p) => ({
    nombre: p.nombre_en_tienda ?? m.nombre,
    precio: p.precio_usd,
  }));
}
---

<Layout
  title="Medicamentos de marca — precios en farmacias de Ecuador"
  description="Precios de medicamentos de marca comercial en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas."
>
  <div class="col">
    <h1>Medicamentos de marca</h1>
    <p class="lead prose">
      Productos que se venden por su nombre comercial. Aparecen aparte del catálogo por principio activo porque su
      nombre no declara qué contienen — así que se comparan entre farmacias, pero todavía no con sus equivalentes
      genéricos.
    </p>

    {
      comparables.length > 0 && (
        <section>
          <p class="field-label">En más de una farmacia · {comparables.length} marcas</p>
          <div class="grid">
            {comparables.map((m) => (
              <div class="marca-item">
                <a class="fila" href={`/marca/${m.slug}/`}>
                  <span class="nombre">{m.nombre}</span>
                  <span class="meta">
                    <span class="cadenas">{m.cadenas.length} cadenas</span>
                    {m.desde != null && <span class="precio">desde {formatPrice(m.desde)}</span>}
                  </span>
                </a>
                <div class="category-preview" data-preview>
                  <div class="category-preview-track" data-preview-track>
                    {previewDeMarca(m).map((item) => (
                      <a class="cp-item" href={`/marca/${m.slug}/`}>
                        <span class="cp-nombre">{item.nombre}</span>
                        <span class="cp-precio">{formatPrice(item.precio)}</span>
                      </a>
                    ))}
                    <a class="cp-vermas" href={`/marca/${m.slug}/`}>
                      Ver todo <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      unaSola.length > 0 && (
        <section class="segunda">
          <p class="field-label">En una sola farmacia · {unaSola.length} marcas</p>
          <div class="grid">
            {unaSola.map((m) => (
              <div class="marca-item">
                <a class="fila" href={`/marca/${m.slug}/`}>
                  <span class="nombre">{m.nombre}</span>
                  <span class="meta">
                    {m.desde != null && <span class="precio">desde {formatPrice(m.desde)}</span>}
                  </span>
                </a>
                <div class="category-preview" data-preview>
                  <div class="category-preview-track" data-preview-track>
                    {previewDeMarca(m).map((item) => (
                      <a class="cp-item" href={`/marca/${m.slug}/`}>
                        <span class="cp-nombre">{item.nombre}</span>
                        <span class="cp-precio">{formatPrice(item.precio)}</span>
                      </a>
                    ))}
                    <a class="cp-vermas" href={`/marca/${m.slug}/`}>
                      Ver todo <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style>
  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .lead {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 2.25rem;
  }
  .field-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }
  .segunda {
    margin-top: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 0 2.5rem;
    border-top: 1px solid var(--ink-faint);
  }
  .marca-item {
    position: relative;
  }
  .fila {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem;
    padding: 0.7rem 0.15rem;
    border-bottom: 1px solid var(--ink-faint);
    text-decoration: none;
    color: var(--ink);
  }
  .nombre {
    font-size: 0.9rem;
    font-weight: 600;
    border-bottom: 1px solid transparent;
  }
  .fila:hover .nombre {
    border-bottom-color: var(--ink);
  }
  .meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .cadenas {
    color: var(--deal-dark);
  }
  .precio {
    color: var(--ink-muted);
  }

  /* ---------- adelanto al pasar el mouse: mismo patron que en el inicio ---------- */
  .category-preview {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 6;
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--ink-faint);
    border-top: none;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 14px 28px rgba(23, 22, 15, 0.18);
    opacity: 0;
    visibility: hidden;
    transition: opacity 160ms var(--ease-print);
    pointer-events: none;
  }
  .marca-item:hover .category-preview,
  .marca-item:focus-within .category-preview {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .category-preview-track {
    display: flex;
    width: max-content;
    transition: transform 1200ms var(--ease-print);
  }
  .cp-item {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 132px;
    padding: 0.6rem 0.7rem;
    text-decoration: none;
    color: var(--ink);
    border-right: 1px solid var(--ink-faint);
    transition: background-color 120ms var(--ease-print);
  }
  .cp-item:hover {
    background-color: rgba(23, 22, 15, 0.04);
  }
  .cp-nombre {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cp-precio {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--stamp);
    font-variant-numeric: tabular-nums;
  }
  .cp-vermas {
    flex: 0 0 auto;
    width: 108px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.6rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--paper-raised);
    background: var(--stamp);
    text-decoration: none;
    text-align: center;
    transition: background-color 140ms var(--ease-print);
  }
  .cp-vermas:hover {
    background: var(--stamp-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .category-preview-track {
      transition: none;
    }
  }
</style>

<script>
  import { activarCarruselesPreview } from "../lib/preview-carousel";
  activarCarruselesPreview(".marca-item");
</script>
