---
import Layout from "../layouts/Layout.astro";
import { getAllDrugs, slugifyPrincipio } from "../lib/supabase";

const drugs = await getAllDrugs();
const seenPrincipios = new Map<string, string>();
for (const d of drugs) {
  const slug = slugifyPrincipio(d.principio_activo);
  if (!seenPrincipios.has(slug)) seenPrincipios.set(slug, d.principio_activo);
}
const totalProductos = drugs.length;
const totalPrincipios = seenPrincipios.size;
const categoriasPopulares = Array.from(seenPrincipios.entries()).slice(0, 10);
---

<Layout
  title="Farma Precios Ecuador — Comparador de precios de medicamentos"
  description="Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. Encuentra el precio más bajo cerca de ti."
>
  <section class="hero">
    <h1>Compara precios de medicamentos en Ecuador</h1>
    <p class="subtitle">
      Busca por nombre comercial y encuentra el precio más bajo entre Fybeca, Pharmacys, Medicity, Cruz Azul y
      Farmacias Económicas.
    </p>

    <div class="search-box">
      <span class="search-icon" aria-hidden="true">🔍</span>
      <input
        id="search-input"
        type="search"
        placeholder="Ej. Losartan, Metformina, Paracetamol..."
        autocomplete="off"
        autofocus
      />
    </div>

    {
      totalProductos > 0 && (
        <p class="stats">
          <strong>{totalProductos}</strong> medicamentos catalogados de <strong>{totalPrincipios}</strong> principios
          activos distintos
        </p>
      )
    }
  </section>

  {
    categoriasPopulares.length > 0 && (
      <section class="chips-section">
        <h2>Búsquedas frecuentes</h2>
        <div class="chips">
          {categoriasPopulares.map(([slug, nombre]) => (
            <a class="chip" href={`/principio/${slug}`}>
              {nombre}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <p class="normalizer-note">
    Nota: todavía no agrupamos genéricos equivalentes por principio activo en los resultados de búsqueda libre
    (esa parte del proyecto está en construcción) — cada fila es el producto tal como aparece en su tienda.
    Compara por nombre y presentación.
  </p>

  <div id="results"></div>

  <!-- AD SLOT: debajo de los resultados de búsqueda — ver Layout.astro para cómo activar -->
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 0.5rem 0 0.5rem;
  }
  h1 {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }
  .subtitle {
    color: var(--muted);
    margin: 0 auto;
    max-width: 46ch;
    font-size: 0.98rem;
  }
  .search-box {
    position: relative;
    margin: 1.5rem auto 0.5rem;
    max-width: 560px;
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    opacity: 0.6;
  }
  #search-input {
    width: 100%;
    font-size: 1.1rem;
    padding: 0.95rem 1rem 0.95rem 2.75rem;
    border: 2px solid var(--border);
    border-radius: 999px;
    outline: none;
    background: var(--card-bg);
    box-shadow: var(--shadow-sm);
  }
  #search-input:focus {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }
  .stats {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.85rem;
  }
  .chips-section {
    margin: 1.75rem 0 0.5rem;
    text-align: center;
  }
  .chips-section h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .chip {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--accent-dark);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .chip:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .normalizer-note {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 1.5rem 0 1.25rem;
    text-align: center;
  }
  #results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>

<script>
  import { searchProducts, PHARMACY_LABELS, PHARMACY_COLORS, pharmacyInitials, type LatestPriceRow } from "../lib/supabase";

  const input = document.getElementById("search-input") as HTMLInputElement;
  const results = document.getElementById("results") as HTMLDivElement;

  let debounceTimer: ReturnType<typeof setTimeout>;
  let requestSeq = 0;

  function formatPrice(value: number | null): string {
    return value == null ? "—" : `$${value.toFixed(2)}`;
  }

  function renderCard(row: LatestPriceRow, isCheapest: boolean): string {
    const pharmacyLabel = PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy;
    const avatarColor = PHARMACY_COLORS[row.pharmacy] ?? "#667085";
    const initials = pharmacyInitials(row.pharmacy);
    const stockLabel =
      row.en_stock === true ? "En stock" : row.en_stock === false ? "Sin stock" : "Disponibilidad no confirmada";
    const stockClass = row.en_stock === true ? "ok" : row.en_stock === false ? "danger" : "muted";
    const promo =
      row.precio_promocional != null && row.precio_promocional < (row.precio_usd ?? Infinity)
        ? `<span class="promo">${formatPrice(row.precio_promocional)}</span>`
        : "";
    // OJO: precio_techo_usd es por unidad (ver Boveda Farmacia/Conceptos/
    // Precio techo.md) y precio_usd es por presentación completa (caja) —
    // NO son comparables directamente todavía (falta extraer unidades por
    // presentación). No se muestra ningún aviso de sobreprecio aquí hasta
    // resolver esa normalización, para no acusar de sobreprecio a una
    // farmacia que en realidad cumple.
    const nombreHtml = row.drug_slug
      ? `<a href="/medicamento/${row.drug_slug}">${escapeHtml(row.nombre_en_tienda ?? "(sin nombre)")}</a>`
      : escapeHtml(row.nombre_en_tienda ?? "(sin nombre)");
    return `
      <article class="price-card ${isCheapest ? "cheapest" : ""}">
        ${isCheapest ? '<span class="price-card-badge">Precio más bajo</span>' : ""}
        <div class="price-card-main">
          <div class="pharmacy-avatar" style="background:${avatarColor}">${initials}</div>
          <div class="price-card-text">
            <h3>${nombreHtml}</h3>
            <p class="pharmacy-name">${escapeHtml(pharmacyLabel)}</p>
            <p class="stock ${stockClass}">${stockLabel}</p>
          </div>
        </div>
        <div class="price-card-side">
          <p class="price">${promo || formatPrice(row.precio_usd)}${promo ? `<s class="price-old">${formatPrice(row.precio_usd)}</s>` : ""}</p>
          ${row.url ? `<a class="cta" href="${escapeAttr(row.url)}" target="_blank" rel="noopener">Ver en tienda</a>` : ""}
        </div>
      </article>`;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function escapeAttr(text: string): string {
    return text.replace(/"/g, "&quot;");
  }

  async function runSearch(term: string) {
    const seq = ++requestSeq;
    if (term.trim().length < 3) {
      results.innerHTML = "";
      return;
    }
    results.innerHTML = `<p class="status">Buscando...</p>`;
    try {
      const rows = await searchProducts(term.trim());
      if (seq !== requestSeq) return; // respuesta obsoleta, ya se lanzó otra búsqueda
      if (rows.length === 0) {
        results.innerHTML = `<p class="status">Sin resultados para "${escapeHtml(term)}".</p>`;
        return;
      }
      const pricedRows = rows.filter((r) => r.precio_usd != null);
      const cheapestId =
        pricedRows.length > 0
          ? pricedRows.reduce((min, r) => ((r.precio_usd ?? Infinity) < (min.precio_usd ?? Infinity) ? r : min)).pharmacy_product_id
          : null;
      results.innerHTML = rows.map((row) => renderCard(row, row.pharmacy_product_id === cheapestId)).join("");
    } catch (err) {
      if (seq !== requestSeq) return;
      results.innerHTML = `<p class="status error">No se pudo conectar con la base de datos. Intenta de nuevo.</p>`;
      console.error(err);
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    const term = input.value;
    debounceTimer = setTimeout(() => runSearch(term), 300);
  });
</script>
