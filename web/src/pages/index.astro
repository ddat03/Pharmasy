---
import Layout from "../layouts/Layout.astro";
import {
  getAllDrugs,
  getAllPricedProductsByDrug,
  getResumen,
  formatFechaLarga,
  slugifyPrincipio,
  PHARMACY_LABELS,
} from "../lib/supabase";
import { CATEGORIAS, categoriaDe } from "../lib/categorias";
import { getPreviewPorCategoria } from "../lib/categoria-preview";
import CategoryIcon from "../components/CategoryIcon.astro";

const [drugs, pricesByDrug, resumen, previewPorCategoria] = await Promise.all([
  getAllDrugs(),
  getAllPricedProductsByDrug(),
  getResumen().catch(() => ({ fecha: null, productosHoy: null, conPrecioTecho: null })),
  getPreviewPorCategoria(),
]);

const seenPrincipios = new Map<string, string>();
const byCategoria = new Map<string, typeof drugs>();
for (const d of drugs) {
  const slug = slugifyPrincipio(d.principio_activo);
  if (!seenPrincipios.has(slug)) seenPrincipios.set(slug, d.principio_activo);
  const cat = categoriaDe(d.principio_activo);
  if (cat) {
    if (!byCategoria.has(cat)) byCategoria.set(cat, []);
    byCategoria.get(cat)!.push(d);
  }
}
const totalProductos = drugs.length;
const totalPrincipios = seenPrincipios.size;
const categoriasPopulares = Array.from(seenPrincipios.entries()).slice(0, 10);

// El calculo del adelanto vive en categoria-preview.ts, compartido con el
// menu del header (Layout.astro) para que ambos usen exactamente la misma
// logica de seleccion -- "hasta 8, nunca por unidad, mas baratos primero" --
// y para no recalcularla dos veces sobre los mismos datos.
const categoriasConDatos = CATEGORIAS.map((c) => ({
  ...c,
  count: byCategoria.get(c.slug)?.length ?? 0,
  preview: previewPorCategoria.get(c.slug) ?? [],
})).filter((c) => c.count > 0);

// Hasta 3 medicamentos con el precio más bajo por categoría (nunca por
// unidad — mismo criterio que en medicamento/principio): una vitrina de
// datos reales, no fotos de stock inventadas.
type MasBaratoItem = {
  nombre: string;
  categoriaNombre: string;
  color: string;
  precioMin: number;
  pharmacy: string;
  slug: string;
};
const masBaratos: MasBaratoItem[] = [];
for (const cat of CATEGORIAS) {
  const enCategoria = byCategoria.get(cat.slug) ?? [];
  const conPrecio = enCategoria
    .map((d) => {
      const prices = (pricesByDrug.get(d.id) ?? []).filter((p) => p.precio_usd != null && !p.precio_por_unidad);
      if (prices.length === 0) return null;
      const cheapest = prices.reduce((min, p) => ((p.precio_usd as number) < (min.precio_usd as number) ? p : min));
      return { drug: d, cheapest };
    })
    .filter((x): x is NonNullable<typeof x> => x !== null)
    .sort((a, b) => (a.cheapest.precio_usd as number) - (b.cheapest.precio_usd as number))
    .slice(0, 3);
  for (const c of conPrecio) {
    masBaratos.push({
      nombre: [c.drug.principio_activo, c.drug.concentracion].filter(Boolean).join(" "),
      categoriaNombre: cat.nombre,
      color: cat.color,
      precioMin: c.cheapest.precio_usd as number,
      pharmacy: PHARMACY_LABELS[c.cheapest.pharmacy] ?? c.cheapest.pharmacy,
      slug: c.drug.slug,
    });
  }
}

type FilaDestacada = { pharmacy: string; precio: number };
type Destacado = { nombre: string; slug: string; filas: FilaDestacada[] };

// Cualquier medicamento comparable en al menos 3 cadenas (nunca por unidad,
// mismo criterio que el resto del sitio) demuestra en un vistazo que hay
// algo real para comparar -- no una foto de stock, un precio real. Se
// juntan TODOS los que cumplen ese piso y se elige uno al azar en cada
// build: quedarse siempre con "el de mas cadenas" resolvia casi siempre al
// mismo medicamento (esa cobertura casi no cambia noche a noche), y la
// tarjeta dice "hoy" -- el sitio es estatico y se reconstruye una vez por
// noche, asi que un sorteo por build ya alcanza para que varie dia a dia
// sin quedar inestable dentro del mismo dia.
let destacado: Destacado | null = null;
{
  const candidatos: { drug: (typeof drugs)[number]; filas: FilaDestacada[] }[] = [];
  for (const d of drugs) {
    // Una fila por farmacia (la mas barata de esa cadena para este
    // medicamento) -- sin este agrupamiento, un medicamento con dos cajas
    // distintas en la misma cadena mostraba esa cadena dos veces en la
    // tarjeta (visto en vivo: "Pharmacys $2.60" y "Pharmacys $12.00" juntas,
    // exactamente la comparacion enganosa que el sitio se niega a mostrar).
    const porCadena = new Map<string, number>();
    for (const p of pricesByDrug.get(d.id) ?? []) {
      if (p.precio_usd == null || p.precio_por_unidad) continue;
      const actual = porCadena.get(p.pharmacy);
      if (actual == null || p.precio_usd < actual) porCadena.set(p.pharmacy, p.precio_usd);
    }
    if (porCadena.size < 3) continue;
    const filas = Array.from(porCadena.entries())
      .sort((a, b) => a[1] - b[1])
      .slice(0, 3)
      .map(([pharmacy, precio]) => ({ pharmacy: PHARMACY_LABELS[pharmacy] ?? pharmacy, precio }));
    candidatos.push({ drug: d, filas });
  }
  if (candidatos.length > 0) {
    const elegido = candidatos[Math.floor(Math.random() * candidatos.length)];
    destacado = {
      nombre: [elegido.drug.principio_activo, elegido.drug.concentracion].filter(Boolean).join(" "),
      slug: elegido.drug.slug,
      filas: elegido.filas,
    };
  }
}

function formatPriceStatic(value: number): string {
  const [whole, cents] = value.toFixed(2).split(".");
  return `$${whole}.${cents}`;
}
---

<Layout
  title="Farma Precios Ecuador — Comparador de precios de medicamentos"
  description="Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. El precio tal cual aparece en cada tienda, sin cálculos."
>
  <section class="hero-d">
    <div class="hero-d-txt">
      <span class="hero-chip">
        <span class="hero-chip-dot" aria-hidden="true"></span>
        Independiente y gratis
      </span>
      <h1 class="hero-title">
        Buscá.<br />Comparás.<br /><em>Ahorrás.</em>
      </h1>
      <p class="hero-sub">
        Compará el precio de {totalProductos} medicamentos en las cinco cadenas más grandes del Ecuador
        {resumen.fecha && <> — actualizado el {formatFechaLarga(resumen.fecha)}</>}.
      </p>
    </div>

    {/* La foto de contexto (nunca un medicamento identificable, ARCSA
        prohíbe mostrarlos) con la tarjeta de un medicamento real flotando
        encima, como apoyada en el mostrador de la propia foto: demuestra
        en un vistazo que hay algo real para comparar, no una promesa. */}
    <div class="hero-d-foto">
      {
        destacado && (
          <a class="hero-card" href={`/medicamento/${destacado.slug}/`}>
            <p class="hero-card-cab">Ejemplo real · hoy</p>
            <h2 class="hero-card-nombre">{destacado.nombre}</h2>
            {destacado.filas.map((f, i) => (
              <div class={`hero-card-fila ${i === 0 ? "best" : ""}`}>
                <span>{f.pharmacy}</span>
                <span class="p">{formatPriceStatic(f.precio)}</span>
              </div>
            ))}
          </a>
        )
      }
    </div>
  </section>

  <div class="col">
    <div class="hero-d-busca">
      <div class="search-box">
        <input
          id="search-input"
          type="search"
          placeholder="Buscá tu medicamento… ej. Losartán, Metformina, Paracetamol"
          autocomplete="off"
        />
        <button type="button" class="search-box-btn" aria-label="Comparar">Comparar</button>
      </div>
    </div>

    {/* Los resultados van pegados al buscador, no al final de la pagina. */}
    <section id="search-panel" class="search-panel" hidden>
      <div id="results" class="ledger"></div>
      <p class="normalizer-note prose">
        Nota: todavía no agrupamos genéricos equivalentes por principio activo en los resultados de búsqueda libre —
        cada fila es el producto tal como aparece en su tienda. Compara por nombre y presentación.
      </p>
    </section>
  </div>

  {
    categoriasConDatos.length > 0 && (
      <section class="categories-section">
        <p class="field-label section-label">Categorías</p>
        <div class="category-grid">
          {categoriasConDatos.map((c, i) => (
            <div class="category-item">
              <a
                class="category-row"
                href={`/categoria/${c.slug}`}
                style={`--cat-color:${c.color};animation-delay:${Math.min(i * 55, 380)}ms`}
              >
                <CategoryIcon name={c.icon} />
                <span class="category-name">{c.nombre}</span>
                <span class="category-count">{c.count}</span>
              </a>
              {/* Al pasar el mouse (nunca al click, que sigue yendo directo
                  a la categoria via .category-row) se desliza un adelanto
                  de productos reales, terminando en "Ver todo" -- misma
                  categoria a la que ya lleva el click en el nombre. */}
              {c.preview.length > 0 && (
                <div class="category-preview" data-preview>
                  <div class="category-preview-track" data-preview-track>
                    {c.preview.map((item) => (
                      <a class="cp-item" href={`/medicamento/${item.slug}/`}>
                        <span class="cp-nombre">{item.nombre}</span>
                        <span class="cp-precio">{formatPriceStatic(item.precio)}</span>
                      </a>
                    ))}
                    <a class="cp-vermas" href={`/categoria/${c.slug}/`}>
                      Ver todo <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    masBaratos.length > 0 && (
      <section class="lowest-section">
        <p class="field-label section-label">Los más baratos de cada categoría</p>
        <div class="lowest-grid">
          {masBaratos.map((item, i) => (
            <a
              class="lowest-row"
              href={`/medicamento/${item.slug}`}
              style={`--cat-color:${item.color};animation-delay:${Math.min(i * 28, 420)}ms`}
            >
              <span class="lowest-cat">{item.categoriaNombre}</span>
              <span class="lowest-name">{item.nombre}</span>
              <span class="lowest-price">{formatPriceStatic(item.precioMin)}</span>
              <span class="lowest-pharmacy">{item.pharmacy}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <div class="col">
    {
      categoriasPopulares.length > 0 && (
        <section class="chips-section">
          <p class="field-label">Búsquedas frecuentes</p>
          <div class="chips">
            {categoriasPopulares.map(([slug, nombre]) => (
              <a class="chip" href={`/principio/${slug}`}>
                {nombre}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- AD SLOT: debajo de los resultados de búsqueda — ver Layout.astro para cómo activar -->
  </div>
</Layout>

<style>
  /* ---------- hero: panel de marca + foto + tarjeta flotante ---------- */
  .hero-d {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--stamp);
  }
  @media (min-width: 860px) {
    .hero-d {
      grid-template-columns: 1fr 1fr;
      min-height: 400px;
    }
  }
  .hero-d-txt {
    color: var(--paper-raised);
    padding: 2.75rem 1.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 860px) {
    .hero-d-txt {
      padding: 3rem calc((100% - var(--page-w) + 3rem) / 2) 3rem 1.5rem;
      padding-left: max(1.5rem, calc((100vw - var(--page-w)) / 2 + 1.5rem));
    }
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    border: 1px solid rgba(255, 253, 247, 0.45);
    border-radius: 999px;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.1rem;
  }
  .hero-chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8fd3ac;
  }
  /* El titular es el unico lugar donde la tipografia sube a escala de
     display: es lo que faltaba para que la primera pantalla diga algo en
     vez de ofrecer un campo de busqueda desnudo. */
  .hero-title {
    margin: 0 0 1rem;
    font-size: clamp(2.1rem, 5.4vw, 3.1rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.032em;
    color: var(--paper-raised);
  }
  .hero-title em {
    /* Dorado calido sobre el azul petroleo: la combinacion clasica de
       "confianza + calidez" en vez del rosa salmon pensado para el rojo
       viejo, que quedaba apagado contra el azul nuevo. */
    font-style: normal;
    color: #dcae5c;
  }
  .hero-sub {
    margin: 0;
    max-width: 42ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 253, 247, 0.86);
  }
  .hero-d-foto {
    position: relative;
    background: url("/farmacia.webp") center/cover;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    min-height: 220px;
  }
  .hero-card {
    display: block;
    width: 100%;
    background: var(--paper-raised);
    border-radius: 10px;
    padding: 1.1rem 1.25rem 1.25rem;
    box-shadow: 0 14px 36px rgba(23, 22, 15, 0.24);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 180ms var(--ease-print),
      box-shadow 180ms var(--ease-print);
  }
  @media (min-width: 860px) {
    .hero-card {
      margin-bottom: -2.4rem;
    }
  }
  .hero-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 44px rgba(23, 22, 15, 0.3);
  }
  .hero-card-cab {
    margin: 0 0 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .hero-card-nombre {
    margin: 0 0 0.7rem;
    font-size: 1.02rem;
    font-weight: 700;
  }
  .hero-card-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-top: 1px solid var(--ink-faint);
    font-size: 0.88rem;
  }
  .hero-card-fila .p {
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .hero-card-fila.best {
    color: var(--deal-dark);
    font-weight: 600;
  }
  .hero-card-fila.best .p {
    color: var(--deal-dark);
  }

  /* ---------- buscador: pildora ancha, separada del hero ---------- */
  .hero-d-busca {
    margin: 2.75rem 0 0;
  }
  @media (min-width: 860px) {
    .hero-d-busca {
      margin-top: 3.25rem;
    }
  }
  .search-box {
    display: flex;
    align-items: stretch;
    background: var(--paper-raised);
    border-radius: 999px;
    border: 1px solid var(--ink-faint);
    box-shadow: 0 2px 12px rgba(23, 22, 15, 0.08);
    overflow: hidden;
    transition:
      border-color 160ms var(--ease-print),
      box-shadow 160ms var(--ease-print);
  }
  .search-box:focus-within {
    border-color: var(--stamp);
    box-shadow: 0 4px 18px rgba(166, 54, 42, 0.18);
  }
  #search-input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    padding: 1rem 1.4rem;
    border: none;
    background: transparent;
    outline: none;
    color: var(--ink);
  }
  #search-input::placeholder {
    color: var(--ink-muted);
    opacity: 0.75;
  }
  .search-box-btn {
    flex-shrink: 0;
    border: none;
    background: var(--ink);
    color: var(--paper-raised);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0 1.9rem;
    cursor: pointer;
    transition: background-color 140ms var(--ease-print);
  }
  .search-box-btn:hover {
    background: var(--stamp-dark);
  }
  .field-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin: 0 0 0.4rem;
  }

  /* ---------- categorías: filas de índice, no tarjetas ---------- */
  .categories-section {
    margin-top: 3rem;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0 2.5rem;
    border-top: 1px solid var(--ink-faint);
  }
  .category-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.65rem;
    margin: 0 -0.65rem;
    border-radius: 3px;
    border-bottom: 1px solid var(--ink-faint);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 140ms var(--ease-print);
  }
  @media (prefers-reduced-motion: no-preference) {
    .category-row {
      animation: print-in 380ms var(--ease-print) backwards;
    }
  }
  .category-row:hover {
    background-color: rgba(23, 22, 15, 0.035);
  }
  .category-row :global(svg) {
    width: 20px;
    height: 20px;
    stroke: var(--cat-color);
    transition: transform 140ms var(--ease-print);
  }
  .category-row:hover :global(svg) {
    transform: scale(1.12);
  }
  .category-name {
    font-weight: 600;
    font-size: 0.94rem;
    border-bottom: 1px solid transparent;
  }
  .category-row:hover .category-name {
    border-bottom-color: var(--cat-color);
  }
  .category-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- adelanto al pasar el mouse: nunca al click ---------- */
  .category-item {
    position: relative;
  }
  .category-preview {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 6;
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--ink-faint);
    border-top: none;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 14px 28px rgba(23, 22, 15, 0.18);
    opacity: 0;
    visibility: hidden;
    transition: opacity 160ms var(--ease-print);
    pointer-events: none;
  }
  .category-item:hover .category-preview,
  .category-item:focus-within .category-preview {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .category-preview-track {
    display: flex;
    width: max-content;
    /* La duracion la fija el JS segun cuanto haya que recorrer, para que la
       velocidad se sienta pareja sin importar si la categoria tiene 3 o 8
       productos -- ver el script mas abajo. */
    transition: transform 1200ms var(--ease-print);
  }
  .cp-item {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 132px;
    padding: 0.6rem 0.7rem;
    text-decoration: none;
    color: var(--ink);
    border-right: 1px solid var(--ink-faint);
    transition: background-color 120ms var(--ease-print);
  }
  .cp-item:hover {
    background-color: rgba(23, 22, 15, 0.04);
  }
  .cp-nombre {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cp-precio {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--stamp);
    font-variant-numeric: tabular-nums;
  }
  .cp-vermas {
    flex: 0 0 auto;
    width: 108px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.6rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--paper-raised);
    background: var(--stamp);
    text-decoration: none;
    text-align: center;
    transition: background-color 140ms var(--ease-print);
  }
  .cp-vermas:hover {
    background: var(--stamp-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .category-preview-track {
      transition: none;
    }
  }

  /* ---------- los más baratos: mismo libro mayor, en tres columnas ---------- */
  .lowest-section {
    margin-top: 3rem;
  }
  .lowest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 0 2.5rem;
    border-top: 1px solid var(--ink-faint);
  }
  .lowest-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "cat price"
      "name pharmacy";
    align-items: baseline;
    column-gap: 0.9rem;
    row-gap: 0.15rem;
    padding: 0.75rem 0.65rem;
    margin: 0 -0.65rem;
    border-radius: 3px;
    border-bottom: 1px solid var(--ink-faint);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 140ms var(--ease-print);
  }
  .lowest-row:hover {
    background-color: rgba(23, 22, 15, 0.035);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lowest-row {
      animation: print-in 340ms var(--ease-print) backwards;
    }
  }
  .lowest-cat {
    grid-area: cat;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--cat-color);
  }
  .lowest-name {
    grid-area: name;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    border-bottom: 1px solid transparent;
    justify-self: start;
  }
  .lowest-row:hover .lowest-name {
    border-bottom-color: var(--ink);
  }
  .lowest-price {
    grid-area: price;
    font-family: var(--font-mono);
    font-size: 1.02rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .lowest-pharmacy {
    grid-area: pharmacy;
    font-size: 0.74rem;
    color: var(--ink-muted);
    text-align: right;
  }

  .chips-section {
    margin-top: 3rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    background: var(--paper-raised);
    border: 1px solid var(--ink-faint);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.4rem 0.8rem;
    border-radius: 3px;
    text-decoration: none;
    transition:
      border-color 140ms var(--ease-print),
      color 140ms var(--ease-print),
      transform 140ms var(--ease-print),
      box-shadow 140ms var(--ease-print);
  }
  .chip:hover {
    border-color: var(--stamp);
    color: var(--stamp-dark);
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(23, 22, 15, 0.08);
  }

  .normalizer-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin: 1rem 0 0;
  }

  .search-panel {
    margin-top: 2rem;
  }
  /* Mientras hay una busqueda en curso, las secciones de exploracion se
     ocultan: son para cuando no sabes que buscar, y con resultados en
     pantalla solo empujan lo que importa fuera de la vista. */
  /* El buscador vive fuera de .hero-d a proposito (ver el markup): asi
     sigue visible aunque el panel de color se oculte durante una busqueda. */
  :global(body.buscando) .categories-section,
  :global(body.buscando) .lowest-section,
  :global(body.buscando) .chips-section,
  :global(body.buscando) .hero-d {
    display: none;
  }
  :global(body.buscando) .hero-d-busca {
    margin-top: 0;
  }
</style>

<script>
  import { searchProducts, PHARMACY_LABELS, PHARMACY_LOGOS, type LatestPriceRow } from "../lib/supabase";
  import { activarCarruselesPreview } from "../lib/preview-carousel";

  activarCarruselesPreview(".category-item");

  const input = document.getElementById("search-input") as HTMLInputElement;
  const boton = document.querySelector(".search-box-btn") as HTMLButtonElement | null;
  const results = document.getElementById("results") as HTMLDivElement;
  const panel = document.getElementById("search-panel") as HTMLElement;

  // Alterna entre "explorar" y "buscar". Sin esto los resultados quedaban
  // debajo de todo el contenido de exploracion y no se veian.
  function mostrarPanel(visible: boolean) {
    panel.hidden = !visible;
    document.body.classList.toggle("buscando", visible);
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  let requestSeq = 0;

  function formatPrice(value: number | null): string {
    if (value == null) return "—";
    const [whole, cents] = value.toFixed(2).split(".");
    return `$${whole}<span class="cents">.${cents}</span>`;
  }

  function renderRow(row: LatestPriceRow, index: number, animate: boolean): string {
    const pharmacyLabel = PHARMACY_LABELS[row.pharmacy] ?? row.pharmacy;
    const logo = PHARMACY_LOGOS[row.pharmacy];
    const stockLabel =
      row.en_stock === true ? "En stock" : row.en_stock === false ? "Sin stock" : "Disponibilidad no confirmada";
    const stockClass = row.en_stock === true ? "ok" : row.en_stock === false ? "danger" : "muted";
    const promo =
      row.precio_promocional != null && row.precio_promocional < (row.precio_usd ?? Infinity)
        ? formatPrice(row.precio_promocional)
        : null;
    // OJO: precio_techo_usd es por unidad (ver Boveda Farmacia/Conceptos/
    // Precio techo.md) y precio_usd es por presentación completa (caja) —
    // NO son comparables directamente todavía. No se muestra ningún aviso
    // de sobreprecio aquí, para no acusar de sobreprecio a una farmacia que
    // en realidad cumple.
    // Sin badge de "mejor precio" aquí: la búsqueda libre no agrupa por
    // medicamento (ver .normalizer-note más abajo), así que un mínimo entre
    // filas de productos distintos sería justo el tipo de comparación que
    // este sitio se niega a inventar. El badge sí es válido en
    // medicamento/[slug] y principio/[slug], donde todas las filas son el
    // mismo producto o el mismo principio activo.
    const nombreHtml = row.drug_slug
      ? `<a href="/medicamento/${row.drug_slug}">${escapeHtml(row.nombre_en_tienda ?? "(sin nombre)")}</a>`
      : escapeHtml(row.nombre_en_tienda ?? "(sin nombre)");
    const delay = animate ? Math.min(index * 45, 360) : 0;
    return `
      <article class="ledger-row ${animate ? "print-in" : ""}" style="animation-delay:${delay}ms">
        <div class="ledger-mark">${logo ? `<img src="${logo}" alt="${escapeAttr(pharmacyLabel)}" loading="lazy" />` : ""}</div>
        <div class="ledger-main">
          <h3>${nombreHtml}</h3>
          <p class="ledger-sub">${escapeHtml(pharmacyLabel)}</p>
          <p class="ledger-stock ${stockClass}">${stockLabel}</p>
        </div>
        <div class="ledger-side">
          <p class="ledger-price"><span class="${animate ? "odometer roll-in" : ""}">${promo ? `${promo}<span class="ledger-price-old">${formatPrice(row.precio_usd)}</span>` : formatPrice(row.precio_usd)}</span></p>
          ${row.precio_por_unidad ? '<p class="ledger-unit-note">precio por unidad, no por caja</p>' : ""}
          ${row.url ? `<a class="ledger-cta" href="${escapeAttr(row.url)}" target="_blank" rel="noopener">Ver en tienda</a>` : ""}
        </div>
      </article>`;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function escapeAttr(text: string): string {
    return text.replace(/"/g, "&quot;");
  }

  // Se anima con el efecto "impreso" solo la primera vez que aparecen
  // resultados en esta sesión de búsqueda; refinar una consulta ya en curso
  // reemplaza las filas sin volver a animar la lista entera (evita el
  // parpadeo de re-imprimir 20+ filas en cada tecla).
  let hasShownResults = false;

  async function runSearch(term: string) {
    const seq = ++requestSeq;
    if (term.trim().length < 3) {
      results.innerHTML = "";
      hasShownResults = false;
      mostrarPanel(false);
      return;
    }
    mostrarPanel(true);
    if (!hasShownResults) {
      results.innerHTML = `<p class="status">Imprimiendo resultados…</p>`;
    }
    try {
      const rows = await searchProducts(term.trim());
      if (seq !== requestSeq) return; // respuesta obsoleta, ya se lanzó otra búsqueda
      if (rows.length === 0) {
        results.innerHTML = `<p class="status">Sin resultados para "${escapeHtml(term)}".</p>`;
        hasShownResults = false;
        return;
      }
      const animate = !hasShownResults;
      results.innerHTML = rows.map((row, i) => renderRow(row, i, animate)).join("");
      hasShownResults = true;
    } catch (err) {
      if (seq !== requestSeq) return;
      results.innerHTML = `<p class="status error">No se pudo conectar con la base de datos. Intenta de nuevo.</p>`;
      hasShownResults = false;
      console.error(err);
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    const term = input.value;
    debounceTimer = setTimeout(() => runSearch(term), 300);
  });

  // Enter busca ya, sin esperar el debounce, y cierra el teclado en mobile —
  // que es lo que tapaba los resultados apenas aparecian.
  input.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    e.preventDefault();
    clearTimeout(debounceTimer);
    input.blur();
    runSearch(input.value);
  });

  // El boton "Comparar" del hero dispara lo mismo que Enter: mismo flujo,
  // sin duplicar la logica de busqueda.
  boton?.addEventListener("click", () => {
    clearTimeout(debounceTimer);
    runSearch(input.value);
  });

  // El buscador del encabezado (presente en todas las paginas menos esta)
  // es un formulario que apunta aca con ?q=. Se recoge al cargar para que
  // buscar desde una pagina de medicamento funcione igual que buscar desde
  // el inicio, sin duplicar la implementacion de la busqueda.
  const termInicial = new URLSearchParams(window.location.search).get("q");
  if (termInicial && termInicial.trim().length >= 3) {
    input.value = termInicial;
    runSearch(termInicial);
    results.scrollIntoView({ behavior: "smooth", block: "start" });
  }
</script>
