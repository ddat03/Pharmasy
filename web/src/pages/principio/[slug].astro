---
// Página por principio activo: todas las presentaciones/concentraciones
// registradas, marcando genérico vs. marca, con el precio más bajo
// encontrado para cada una.
import Layout from "../../layouts/Layout.astro";
import { getAllDrugs, getAllPricedProductsByDrug, slugifyPrincipio, type Drug } from "../../lib/supabase";

export async function getStaticPaths() {
  const [drugs, pricesByDrug] = await Promise.all([getAllDrugs(), getAllPricedProductsByDrug()]);
  const bySlug = new Map<string, Drug[]>();
  for (const drug of drugs) {
    const slug = slugifyPrincipio(drug.principio_activo);
    if (!bySlug.has(slug)) bySlug.set(slug, []);
    bySlug.get(slug)!.push(drug);
  }
  return Array.from(bySlug.entries()).map(([slug, group]) => {
    const withPrices = group.map((drug) => {
      const prices = pricesByDrug.get(drug.id) ?? [];
      const priced = prices.filter((p) => p.precio_usd != null);
      const min = priced.length > 0 ? Math.min(...priced.map((p) => p.precio_usd as number)) : null;
      return { drug, precioMin: min, nFarmacias: prices.length };
    });
    return {
      params: { slug },
      props: { principioActivo: group[0].principio_activo, items: withPrices },
    };
  });
}

interface Item {
  drug: Drug;
  precioMin: number | null;
  nFarmacias: number;
}
interface Props {
  principioActivo: string;
  items: Item[];
}
const { principioActivo, items } = Astro.props;
items.sort((a, b) => (a.precioMin ?? Infinity) - (b.precioMin ?? Infinity));
const cheapestSlug = items.find((i) => i.precioMin != null)?.drug.slug;

function formatPrice(value: number | null): string {
  return value == null ? "—" : `$${value.toFixed(2)}`;
}

const seoTitle = `${principioActivo}: presentaciones, genéricos y precios en Ecuador | Farma Precios Ecuador`;
const seoDescription = `Todas las presentaciones de ${principioActivo} disponibles en Ecuador (genéricos y marca), con el precio más bajo encontrado en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas.`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Presentaciones de ${principioActivo}`,
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/medicamento/${item.drug.slug}`, Astro.site).toString(),
    name: [item.drug.principio_activo, item.drug.concentracion, item.drug.forma_farmaceutica].filter(Boolean).join(" "),
  })),
};
---

<Layout title={seoTitle} description={seoDescription} structuredData={structuredData}>
  <p class="breadcrumb"><a href="/">Buscador</a></p>
  <h1>{principioActivo}</h1>
  <p class="subtitle">
    Todas las presentaciones registradas de este principio activo, con el precio más bajo encontrado en cada
    una. Mismo principio activo — consulte a su médico o farmacéutico antes de sustituir un medicamento.
  </p>

  <div class="price-list">
    {
      items.map(({ drug, precioMin, nFarmacias }) => (
        <a class={`card ${drug.slug === cheapestSlug ? "cheapest" : ""}`} href={`/medicamento/${drug.slug}`}>
          {drug.slug === cheapestSlug && <span class="card-badge">Más económico</span>}
          <div class="card-main">
            <h3>
              {drug.concentracion} {drug.forma_farmaceutica}
            </h3>
            <p class="pharmacy">
              <span class={`tag ${drug.es_generico ? "generico" : "marca"}`}>
                {drug.es_generico ? "Genérico" : "Marca"}
              </span>
              {drug.laboratorio ? ` ${drug.laboratorio}` : ""}
            </p>
          </div>
          <div class="card-side">
            <p class="price">{nFarmacias > 0 ? `desde ${formatPrice(precioMin)}` : "—"}</p>
            <p class="n-farmacias">{nFarmacias} {nFarmacias === 1 ? "oferta" : "ofertas"}</p>
          </div>
        </a>
      ))
    }
  </div>

  <!-- AD SLOT: debajo del listado de presentaciones — ver Layout.astro para cómo activar -->
</Layout>

<style>
  .breadcrumb {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--accent-dark);
  }
  h1 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.1rem;
  }
  .subtitle {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .price-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }
  .card.cheapest {
    border-color: var(--deal);
    box-shadow: 0 0 0 1px var(--deal), var(--shadow-sm);
  }
  .card-badge {
    position: absolute;
    top: -0.65rem;
    left: 1rem;
    background: var(--deal);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }
  .card-main h3 {
    margin: 0 0 0.3rem;
    font-size: 1rem;
  }
  .pharmacy {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 5px;
    margin-right: 0.35rem;
  }
  .tag.generico {
    background: var(--deal-bg);
    color: var(--deal);
  }
  .tag.marca {
    background: #eef1f8;
    color: var(--muted);
  }
  .card-side {
    text-align: right;
    min-width: 140px;
  }
  .price {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--accent-dark);
  }
  .n-farmacias {
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .card {
      flex-direction: column;
    }
    .card-side {
      text-align: left;
    }
  }
</style>
