---
// Página por principio activo: todas las presentaciones/concentraciones
// registradas, marcando genérico vs. marca, con el precio más bajo
// encontrado para cada una.
import Layout from "../../layouts/Layout.astro";
import { getAllDrugs, getPricesForDrug, slugifyPrincipio, type Drug } from "../../lib/supabase";

export async function getStaticPaths() {
  const drugs = await getAllDrugs();
  const bySlug = new Map<string, Drug[]>();
  for (const drug of drugs) {
    const slug = slugifyPrincipio(drug.principio_activo);
    if (!bySlug.has(slug)) bySlug.set(slug, []);
    bySlug.get(slug)!.push(drug);
  }
  return Promise.all(
    Array.from(bySlug.entries()).map(async ([slug, group]) => {
      const withPrices = await Promise.all(
        group.map(async (drug) => {
          const prices = await getPricesForDrug(drug.id);
          const priced = prices.filter((p) => p.precio_usd != null);
          const min = priced.length > 0 ? Math.min(...priced.map((p) => p.precio_usd as number)) : null;
          return { drug, precioMin: min, nFarmacias: prices.length };
        }),
      );
      return {
        params: { slug },
        props: { principioActivo: group[0].principio_activo, items: withPrices },
      };
    }),
  );
}

interface Item {
  drug: Drug;
  precioMin: number | null;
  nFarmacias: number;
}
interface Props {
  principioActivo: string;
  items: Item[];
}
const { principioActivo, items } = Astro.props;
items.sort((a, b) => (a.precioMin ?? Infinity) - (b.precioMin ?? Infinity));

function formatPrice(value: number | null): string {
  return value == null ? "—" : `$${value.toFixed(2)}`;
}
---

<Layout title={`${principioActivo} — presentaciones y precios | Farma Precios Ecuador`}>
  <p class="breadcrumb"><a href="/">Buscador</a></p>
  <h1>{principioActivo}</h1>
  <p class="subtitle">
    Todas las presentaciones registradas de este principio activo, con el precio más bajo encontrado en cada
    una. Mismo principio activo — consulte a su médico o farmacéutico antes de sustituir un medicamento.
  </p>

  <div class="price-list">
    {
      items.map(({ drug, precioMin, nFarmacias }) => (
        <a class="card" href={`/medicamento/${drug.slug}`}>
          <div class="card-main">
            <h3>
              {drug.concentracion} {drug.forma_farmaceutica}
            </h3>
            <p class="pharmacy">
              {drug.es_generico ? "Genérico" : "Marca"}
              {drug.laboratorio ? ` · ${drug.laboratorio}` : ""}
            </p>
          </div>
          <div class="card-side">
            <p class="price">{nFarmacias > 0 ? `desde ${formatPrice(precioMin)}` : "—"}</p>
            <p class="n-farmacias">{nFarmacias} {nFarmacias === 1 ? "oferta" : "ofertas"}</p>
          </div>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  .breadcrumb {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--accent-dark);
  }
  h1 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.1rem;
  }
  .subtitle {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .price-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-main h3 {
    margin: 0 0 0.15rem;
    font-size: 1rem;
  }
  .pharmacy {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .card-side {
    text-align: right;
    min-width: 140px;
  }
  .price {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-dark);
  }
  .n-farmacias {
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .card {
      flex-direction: column;
    }
    .card-side {
      text-align: left;
    }
  }
</style>
