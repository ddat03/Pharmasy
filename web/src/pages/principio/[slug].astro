---
// Página por principio activo: todas las presentaciones/concentraciones
// registradas, marcando genérico vs. marca, con el precio más bajo
// encontrado para cada una.
import Layout from "../../layouts/Layout.astro";
import { getAllDrugs, getAllPricedProductsByDrug, slugifyPrincipio, type Drug } from "../../lib/supabase";

export async function getStaticPaths() {
  const [drugs, pricesByDrug] = await Promise.all([getAllDrugs(), getAllPricedProductsByDrug()]);
  const bySlug = new Map<string, Drug[]>();
  for (const drug of drugs) {
    const slug = slugifyPrincipio(drug.principio_activo);
    if (!bySlug.has(slug)) bySlug.set(slug, []);
    bySlug.get(slug)!.push(drug);
  }
  return Array.from(bySlug.entries()).map(([slug, group]) => {
    const withPrices = group.map((drug) => {
      const prices = pricesByDrug.get(drug.id) ?? [];
      const priced = prices.filter((p) => p.precio_usd != null);
      // Precios por unidad suelta (ver medicamento/[slug].astro) quedan
      // fuera del "desde $X": no son comparables contra el precio de caja
      // de las demás farmacias.
      const comparable = priced.filter((p) => !p.precio_por_unidad);
      const minSource = comparable.length > 0 ? comparable : priced;
      const min = minSource.length > 0 ? Math.min(...minSource.map((p) => p.precio_usd as number)) : null;
      return { drug, precioMin: min, nFarmacias: prices.length };
    });
    return {
      params: { slug },
      props: { principioActivo: group[0].principio_activo, items: withPrices },
    };
  });
}

interface Item {
  drug: Drug;
  precioMin: number | null;
  nFarmacias: number;
}
interface Props {
  principioActivo: string;
  items: Item[];
}
const { principioActivo, items } = Astro.props;
items.sort((a, b) => (a.precioMin ?? Infinity) - (b.precioMin ?? Infinity));
const cheapestSlug = items.find((i) => i.precioMin != null)?.drug.slug;

function formatPrice(value: number | null): string {
  if (value == null) return "—";
  const [whole, cents] = value.toFixed(2).split(".");
  return `$${whole}.${cents}`;
}

const seoTitle = `${principioActivo}: presentaciones, genéricos y precios en Ecuador | Farma Precios Ecuador`;
const seoDescription = `Todas las presentaciones de ${principioActivo} disponibles en Ecuador (genéricos y marca), con el precio más bajo encontrado en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas.`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Presentaciones de ${principioActivo}`,
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/medicamento/${item.drug.slug}`, Astro.site).toString(),
    name: [item.drug.principio_activo, item.drug.concentracion, item.drug.forma_farmaceutica].filter(Boolean).join(" "),
  })),
};
---

<Layout title={seoTitle} description={seoDescription} structuredData={structuredData}>
  <div class="col">
  <p class="breadcrumb"><a href="/">Buscador</a></p>
  <h1>{principioActivo}</h1>
  <p class="subtitle">
    Todas las presentaciones registradas de este principio activo, con el precio más bajo encontrado en cada
    una. Mismo principio activo — consulte a su médico o farmacéutico antes de sustituir un medicamento.
  </p>

  <div class="tear" aria-hidden="true"></div>

  <div class="ledger">
    {
      items.map(({ drug, precioMin, nFarmacias }, i) => {
        const isCheapest = drug.slug === cheapestSlug;
        const delay = Math.min(i * 45, 360);
        return (
          <a class={`ledger-row print-in presentation-row ${isCheapest ? "is-cheapest" : ""}`} href={`/medicamento/${drug.slug}`} style={`animation-delay:${delay}ms`}>
            {isCheapest && <span class="stamp-badge">Mejor precio</span>}
            <span class={`tag ${drug.es_generico ? "generico" : "marca"}`}>{drug.es_generico ? "GEN" : "MARCA"}</span>
            <div class="ledger-main">
              <p class="ledger-name">
                {drug.concentracion} {drug.forma_farmaceutica}
              </p>
              <p class="ledger-sub">{drug.laboratorio ?? "Laboratorio no confirmado"}</p>
            </div>
            <div class="ledger-side">
              <p class="ledger-price">
                {nFarmacias > 0 ? (
                  <>
                    <span class="from">desde</span> <span class="odometer roll-in">{formatPrice(precioMin)}</span>
                  </>
                ) : (
                  "—"
                )}
              </p>
              <p class="ledger-stock muted">
                {nFarmacias} {nFarmacias === 1 ? "oferta" : "ofertas"}
              </p>
            </div>
          </a>
        );
      })
    }
  </div>

  <!-- AD SLOT: debajo del listado de presentaciones — ver Layout.astro para cómo activar -->
  </div>
</Layout>

<style>
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }
  .breadcrumb a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--ink-faint);
    text-underline-offset: 3px;
  }
  .breadcrumb a:hover {
    color: var(--stamp-dark);
  }
  h1 {
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0.3rem 0 0.15rem;
  }
  .subtitle {
    color: var(--ink-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .presentation-row {
    text-decoration: none;
    color: inherit;
    grid-template-columns: auto 1fr auto;
  }
  .presentation-row:hover .ledger-name {
    border-bottom-color: var(--stamp);
  }
  .ledger-name {
    border-bottom: 1px solid transparent;
    display: inline-block;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    flex-shrink: 0;
    justify-self: start;
  }
  .tag.generico {
    background: var(--deal-bg);
    color: var(--deal-dark);
  }
  .tag.marca {
    background: var(--paper-edge);
    color: var(--ink-muted);
  }
  .from {
    font-size: 0.7rem;
    color: var(--ink-muted);
    font-family: var(--font-sans);
  }
</style>
