---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = "Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. El precio tal cual aparece en cada tienda, sin cálculos.",
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!--
  THESIS: Un comparador de precios se siente como una factura ecuatoriana, no
  como un panel de SaaS azul — porque el producto ya promete lo mismo que una
  factura promete (esto es exactamente lo que se cobra, verificable, nunca
  inventado), y la categoría siempre envía tarjetas redondeadas con
  degradado azul o el opuesto clínico blanco-hospital; ninguno de los dos.
  OWN-WORLD: papel crema (#F7F3EA), tinta casi negra, un acento tipo tinta de
  sello (#A6362A); IBM Plex Sans/Mono; filas de libro mayor con reglas finas
  en vez de tarjetas; el precio techo oficial vive en su propia línea de
  "impuesto/regulación" — separada del ledger por una perforación, como una
  sección aparte de la misma factura — nunca mezclado con el precio de la
  farmacia ni sumado a la tabla que sí se compara entre farmacias.
  STORY: el visitante entiende que esto lee precios reales de 5 farmacias
  como leería una factura — exacto, verificable — y encuentra el más barato
  sin que el sitio le calcule ni le sugiera nada.
  FIRST VIEWPORT: buscador arriba con rótulos tipo encabezado de factura;
  los resultados se "imprimen" como filas de un ticket a medida que llegan.
  FORM: La Factura — mi candidato #1 (de 7), elegido directamente por el
  usuario tras ver la dirección asignada por dado (letrero neón, candidato
  #6) y pedir el pick real. Sin seed key (el catálogo de retadores de
  impeccable no fue alcanzable desde esta sesión — ver PRODUCT.md).
  FINISH: unreviewed and undocumented is unfinished; this build ends with
  the finish review, the verdict, and DESIGN.md.
-->
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Farma Precios Ecuador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!--
      Slot de anuncios (Google AdSense) — preparado, sin activar todavía.
      Cuando exista una cuenta AdSense aprobada:
        1. Agregar el script de verificación del sitio en <head>:
           <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>
        2. Crear public/ads.txt con la línea que da AdSense
           (google.com, pub-XXXXXXXXXX, DIRECT, f08c47fec0942fa0).
        3. Descomentar los <ins class="adsbygoogle"> donde corresponda
           (ver comentarios "AD SLOT" en index.astro y medicamento/[slug].astro).
      Ver Boveda Farmacia/Conceptos/Monetización.
    -->
  </head>
  <body>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {
          Array.from({ length: 2 }).map(() => (
            <>
              <span>2,875 productos comparados</span>
              <span class="ticker-dot">·</span>
              <span>137 con precio techo oficial verificado</span>
              <span class="ticker-dot">·</span>
              <span>5 cadenas de farmacia, un solo lugar</span>
              <span class="ticker-dot">·</span>
              <span>nunca inventamos ni calculamos precios</span>
              <span class="ticker-dot">·</span>
            </>
          ))
        }
      </div>
    </div>

    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-word">Farma Precios</span>
        <span class="brand-stamp">EC</span>
      </a>
      <p class="tagline">Precios reales, tal cual los cobra cada farmacia</p>
    </header>

    <div class="disclaimer">
      Información referencial de precios. No constituye consejo médico. Consulte a su médico o farmacéutico.
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-perf" aria-hidden="true"></div>
      <p>
        Datos recopilados de Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. Proyecto independiente,
        sin afiliación con ninguna cadena.
      </p>
      <p><a href="/politica-de-privacidad">Política de privacidad</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f3ea;
    --paper-edge: #e8e0cc;
    --paper-raised: #fffdf7;
    --ink: #1c1b18;
    --ink-muted: #746b57;
    --ink-faint: rgba(28, 27, 24, 0.13);
    --ink-faint-2: rgba(28, 27, 24, 0.07);
    --stamp: #a6362a;
    --stamp-dark: #7c271e;
    --stamp-bg: #f3e2df;
    --deal: #2f6b4f;
    --deal-dark: #1f4d38;
    --deal-bg: #e3ede6;
    --warn: #6b4a15;
    --warn-bg: #f3e9d4;
    --shadow-sm: 0 1px 2px rgba(28, 27, 24, 0.09);
    --font-sans:
      "IBM Plex Sans", system-ui, sans-serif;
    --font-mono:
      "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
    --ease-print: cubic-bezier(0.16, 1, 0.3, 1);
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: var(--stamp);
    color: var(--paper-raised);
  }

  html {
    scrollbar-color: var(--ink-muted) var(--paper);
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }

  /* ---------- ticker: franja de hechos reales, en movimiento continuo ---------- */
  .ticker {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    white-space: nowrap;
    padding: 0.4rem 0;
  }
  .ticker-track {
    display: inline-flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .ticker-dot {
    color: var(--stamp);
    margin: 0 0.35rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      width: max-content;
      animation: ticker-scroll 32s linear infinite;
    }
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- header ---------- */
  .site-header {
    padding: 1.6rem 1.5rem 1.1rem;
    max-width: 1180px;
    margin: 0 auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .brand-word {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand-stamp {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--stamp);
    border: 1.5px solid var(--stamp);
    border-radius: 3px;
    padding: 0.1rem 0.32rem;
    transform: rotate(-3deg);
  }
  .tagline {
    margin: 0.35rem 0 0;
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .disclaimer {
    background: var(--warn-bg);
    color: var(--warn);
    font-size: 0.78rem;
    padding: 0.5rem 1.25rem;
    text-align: center;
    border-top: 1px solid var(--ink-faint);
    border-bottom: 1px solid var(--ink-faint);
  }

  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.75rem 1.5rem 3rem;
  }

  /* columna angosta y legible para tablas comparativas dentro de main,
     que ahora es ancho para dejar espacio a categorías/carrusel a los
     lados en el home. */
  .col {
    max-width: 760px;
    margin: 0 auto;
  }

  /* ---------- footer ---------- */
  .site-footer {
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
    color: var(--ink-muted);
    font-size: 0.78rem;
    padding: 0 1.5rem 2.5rem;
  }
  .footer-perf {
    height: 1px;
    background-image: radial-gradient(circle, var(--ink-muted) 1px, transparent 1.2px);
    background-size: 10px 1px;
    background-repeat: repeat-x;
    opacity: 0.4;
    margin-bottom: 1.5rem;
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--ink-faint);
    text-underline-offset: 3px;
  }

  /* ---------- ledger: fila de resultado compartida entre buscador / medicamento / principio activo ---------- */
  .ledger {
    display: flex;
    flex-direction: column;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--ink-faint);
    position: relative;
  }
  .ledger-row:first-child {
    border-top: 1px solid var(--ink-faint);
  }
  .ledger-row.is-cheapest {
    background: linear-gradient(90deg, var(--deal-bg), transparent 60%);
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    border-radius: 3px;
  }
  .ledger-mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-faint);
    background: var(--paper-raised);
    padding: 5px;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .ledger-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .ledger-main {
    min-width: 0;
  }
  .ledger-main h3,
  .ledger-main .ledger-name {
    margin: 0 0 0.15rem;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: break-word;
  }
  .ledger-main h3 a,
  .ledger-main .ledger-name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .ledger-main h3 a:hover,
  .ledger-main .ledger-name a:hover {
    border-bottom-color: var(--stamp);
  }
  .ledger-sub {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .ledger-side {
    text-align: right;
    flex-shrink: 0;
  }
  .ledger-price {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ledger-price .cents {
    font-size: 0.72em;
    color: var(--ink-muted);
  }
  .ledger-unit-note {
    margin: 0.2rem 0 0;
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--warn);
    background: var(--warn-bg);
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
    display: inline-block;
  }
  .ledger-price-old {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    text-decoration: line-through;
    margin-left: 0.35rem;
  }
  .ledger-stock {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }
  .ledger-stock.ok {
    color: var(--deal-dark);
  }
  .ledger-stock.danger {
    color: var(--stamp-dark);
  }
  .ledger-stock.muted {
    color: var(--ink-muted);
  }
  .ledger-cta {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--paper-raised);
    background: var(--ink);
    padding: 0.32rem 0.65rem;
    border-radius: 3px;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .ledger-cta:hover {
    background: var(--stamp-dark);
  }

  /* stamp badge: precio más bajo / mejor oferta */
  .stamp-badge {
    position: absolute;
    top: -0.55rem;
    left: 0.6rem;
    background: var(--deal);
    color: var(--paper-raised);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    transform: rotate(-2deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .stamp-badge {
      animation: stamp-impact 260ms var(--ease-print) backwards;
    }
  }
  @keyframes stamp-impact {
    0% {
      opacity: 0;
      transform: scale(1.5) rotate(-8deg);
    }
    60% {
      opacity: 1;
      transform: scale(0.94) rotate(-1deg);
    }
    100% {
      transform: scale(1) rotate(-2deg);
    }
  }

  /* perforación entre secciones */
  .tear {
    height: 1px;
    margin: 1.75rem 0;
    background-image: radial-gradient(circle, var(--ink-muted) 1px, transparent 1.2px);
    background-size: 9px 1px;
    background-repeat: repeat-x;
    opacity: 0.35;
  }

  /* estados de texto */
  .status {
    color: var(--ink-muted);
    text-align: center;
    padding: 1.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .status.error {
    color: var(--stamp-dark);
  }

  /* entrada "impresa" por fila, activada con la clase .is-printing vía JS/scroll */
  @media (prefers-reduced-motion: no-preference) {
    .ledger-row.print-in {
      animation: print-in 320ms var(--ease-print) backwards;
    }
  }
  @keyframes print-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* números tipo odómetro: los dígitos entran deslizándose hacia arriba y
     recortados, como una rueda mecánica que se detiene en su lugar, en vez
     de un simple fundido. */
  .odometer {
    display: inline-block;
    overflow: hidden;
    line-height: 1.15;
  }
  @media (prefers-reduced-motion: no-preference) {
    .odometer.roll-in {
      animation: odometer-roll 480ms var(--ease-print) backwards;
    }
  }
  @keyframes odometer-roll {
    0% {
      opacity: 0;
      transform: translateY(65%);
    }
    55% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
