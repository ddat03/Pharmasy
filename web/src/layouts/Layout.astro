---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";

import { getResumen, formatFechaLarga } from "../lib/supabase";

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = "Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. El precio tal cual aparece en cada tienda, sin cálculos.",
  structuredData,
} = Astro.props;

// La fecha del dato vive en el header de todas las paginas: es lo que
// separa un precio verificable de un numero cualquiera. Si la consulta
// falla, el header simplemente no la muestra — nunca se inventa una fecha.
// getResumen() esta cacheado a nivel de modulo: se consulta una vez por
// build, no una vez por cada una de las 1231 paginas.
const resumen = await getResumen().catch(() => ({ fecha: null, productosHoy: null, conPrecioTecho: null }));
const ultimaActualizacion = resumen.fecha;

// La franja superior decia "2,875 productos comparados" y "137 con precio
// techo oficial verificado" con los numeros escritos a mano en el codigo.
// Eran ciertos el dia que se escribieron y dejaron de serlo despues: una
// cifra fija sobre datos que cambian todas las noches es una afirmacion
// falsa esperando su turno. Ahora salen de la base, y el dato que no se
// pueda confirmar simplemente no se muestra.
const hechos = [
  resumen.productosHoy != null ? `${resumen.productosHoy.toLocaleString("es-EC")} precios verificados hoy` : null,
  resumen.conPrecioTecho != null ? `${resumen.conPrecioTecho} con precio techo oficial` : null,
  "5 cadenas de farmacia, un solo lugar",
  "nunca inventamos ni calculamos precios",
].filter((h): h is string => h !== null);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!--
  THESIS: Un comparador de precios se siente como una factura ecuatoriana, no
  como un panel de SaaS azul — porque el producto ya promete lo mismo que una
  factura promete (esto es exactamente lo que se cobra, verificable, nunca
  inventado), y la categoría siempre envía tarjetas redondeadas con
  degradado azul o el opuesto clínico blanco-hospital; ninguno de los dos.
  OWN-WORLD: papel crema (#F7F3EA), tinta casi negra, un acento tipo tinta de
  sello (#A6362A); IBM Plex Sans/Mono; filas de libro mayor con reglas finas
  en vez de tarjetas; el precio techo oficial vive en su propia línea de
  "impuesto/regulación" — separada del ledger por una perforación, como una
  sección aparte de la misma factura — nunca mezclado con el precio de la
  farmacia ni sumado a la tabla que sí se compara entre farmacias.
  STORY: el visitante entiende que esto lee precios reales de 5 farmacias
  como leería una factura — exacto, verificable — y encuentra el más barato
  sin que el sitio le calcule ni le sugiera nada.
  FIRST VIEWPORT: buscador arriba con rótulos tipo encabezado de factura;
  los resultados se "imprimen" como filas de un ticket a medida que llegan.
  FORM: La Factura — mi candidato #1 (de 7), elegido directamente por el
  usuario tras ver la dirección asignada por dado (letrero neón, candidato
  #6) y pedir el pick real. Sin seed key (el catálogo de retadores de
  impeccable no fue alcanzable desde esta sesión — ver PRODUCT.md).
  FINISH: unreviewed and undocumented is unfinished; this build ends with
  the finish review, the verdict, and DESIGN.md.
-->
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Farma Precios Ecuador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!--
      Slot de anuncios (Google AdSense) — preparado, sin activar todavía.
      Cuando exista una cuenta AdSense aprobada:
        1. Agregar el script de verificación del sitio en <head>:
           <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>
        2. Crear public/ads.txt con la línea que da AdSense
           (google.com, pub-XXXXXXXXXX, DIRECT, f08c47fec0942fa0).
        3. Descomentar los <ins class="adsbygoogle"> donde corresponda
           (ver comentarios "AD SLOT" en index.astro y medicamento/[slug].astro).
      Ver Boveda Farmacia/Conceptos/Monetización.
    -->
  </head>
  <body>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {
          Array.from({ length: 2 }).map(() => (
            <>
              {hechos.map((hecho) => (
                <>
                  <span>{hecho}</span>
                  <span class="ticker-dot">·</span>
                </>
              ))}
            </>
          ))
        }
      </div>
    </div>

    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-word">Farma Precios</span>
        <span class="brand-stamp">EC</span>
      </a>
      {
        ultimaActualizacion && (
          <p class="freshness">
            <span class="freshness-dot" aria-hidden="true" />
            Precios del <strong>{formatFechaLarga(ultimaActualizacion)}</strong>
          </p>
        )
      }
    </header>

    <div class="disclaimer">
      <span>Información referencial de precios. No constituye consejo médico. Consulte a su médico o farmacéutico.</span>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-perf" aria-hidden="true"></div>
      <p>
        Datos recopilados de Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. Proyecto independiente,
        sin afiliación con ninguna cadena.
      </p>
      <p><a href="/politica-de-privacidad">Política de privacidad</a></p>
      <p class="footer-sign">Creado por Diego Aleman</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f3ea;
    --paper-edge: #e8e0cc;
    --paper-raised: #fffdf7;
    --ink: #17160f;
    /* #746b57 sobre el papel daba 4.0:1 — por debajo del minimo legible para
       texto normal. Este mismo matiz, mas oscuro, llega a 5.9:1 sin salirse
       del mundo de tinta sobre papel. */
    --ink-muted: #57503f;
    --ink-faint: rgba(23, 22, 15, 0.2);
    --ink-faint-2: rgba(23, 22, 15, 0.08);
    --stamp: #a6362a;
    --stamp-dark: #7c271e;
    --stamp-bg: #f3e2df;
    --deal: #2f6b4f;
    --deal-dark: #1f4d38;
    --deal-bg: #e3ede6;
    --warn: #6b4a15;
    --warn-bg: #f3e9d4;
    --shadow-sm: 0 1px 2px rgba(28, 27, 24, 0.09);
    --font-sans:
      "IBM Plex Sans", system-ui, sans-serif;
    --font-mono:
      "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
    --ease-print: cubic-bezier(0.16, 1, 0.3, 1);
    --page-w: 980px;
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: var(--stamp);
    color: var(--paper-raised);
  }

  html {
    scrollbar-color: var(--ink-muted) var(--paper);
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }

  /* ---------- ticker: franja de hechos reales, en movimiento continuo ---------- */
  .ticker {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    white-space: nowrap;
    padding: 0.4rem 0;
  }
  .ticker-track {
    display: inline-flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .ticker-dot {
    color: var(--stamp);
    margin: 0 0.35rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      width: max-content;
      animation: ticker-scroll 32s linear infinite;
    }
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- header ---------- */
  /* Un solo ancho para toda la pagina. Antes el header y las secciones
     anchas vivian en 1180px y el contenido de lectura en una columna de
     760px centrada dentro de ese ancho: dos cajas centradas de distinto
     tamano no comparten ningun borde, asi que en desktop nada alineaba con
     nada. Ahora hay una sola caja y todo cuelga de su misma linea. */
  .site-header {
    padding: 1.9rem 1.5rem 1.3rem;
    max-width: var(--page-w);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .brand-word {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand-stamp {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--stamp);
    border: 1.5px solid var(--stamp);
    border-radius: 3px;
    padding: 0.1rem 0.32rem;
    transform: rotate(-3deg);
  }
  /* Sello de frescura: el dato que le dice al visitante si esto es de hoy.
     Va en el header, no escondido en el pie, porque es la mitad de la
     promesa del producto — la otra mitad es el precio. */
  .freshness {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .freshness strong {
    color: var(--ink);
    font-weight: 600;
  }
  .freshness-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--deal);
    flex-shrink: 0;
  }

  /* Franja a todo el ancho, pero su texto arranca en la misma linea
     vertical que el resto de la pagina: si no, es lo unico centrado en un
     diseno alineado a la izquierda y se lee como una pieza suelta. */
  .disclaimer {
    background: var(--warn-bg);
    color: var(--warn);
    font-size: 0.78rem;
    border-top: 1px solid var(--ink-faint);
    border-bottom: 1px solid var(--ink-faint);
  }
  .disclaimer > span {
    display: block;
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 0.55rem 1.5rem;
  }

  main {
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 2rem 1.5rem 3.5rem;
  }

  /* `.col` ya no reduce el ancho: existe solo como agrupador semantico
     heredado de las paginas. La medida de lectura se limita por bloque de
     prosa (.prose), no encogiendo la pagina entera — las filas del libro
     mayor se leen mejor anchas, con el precio anclado al borde derecho. */
  .col {
    max-width: 100%;
  }

  /* Medida de lectura para parrafos de prosa: ~68 caracteres. */
  .prose {
    max-width: 62ch;
  }

  /* ---------- footer ---------- */
  .site-footer {
    max-width: var(--page-w);
    margin: 0 auto;
    text-align: left;
    color: var(--ink-muted);
    font-size: 0.78rem;
    padding: 0 1.5rem 2.5rem;
  }
  .footer-perf {
    height: 1px;
    background-image: radial-gradient(circle, var(--ink-muted) 1px, transparent 1.2px);
    background-size: 10px 1px;
    background-repeat: repeat-x;
    opacity: 0.4;
    margin-bottom: 1.5rem;
  }
  .footer-sign {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    opacity: 0.7;
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--ink-faint);
    text-underline-offset: 3px;
  }

  /* ---------- ledger: fila de resultado compartida entre buscador / medicamento / principio activo ---------- */
  .ledger {
    display: flex;
    flex-direction: column;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--ink-faint);
    position: relative;
  }
  .ledger-row:first-child {
    border-top: 1px solid var(--ink-faint);
  }
  .ledger-row.is-cheapest {
    background: linear-gradient(90deg, var(--deal-bg), transparent 60%);
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    border-radius: 3px;
  }
  .ledger-mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-faint);
    background: var(--paper-raised);
    padding: 5px;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .ledger-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .ledger-main {
    min-width: 0;
  }
  .ledger-main h3,
  .ledger-main .ledger-name {
    margin: 0 0 0.15rem;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: break-word;
  }
  .ledger-main h3 a,
  .ledger-main .ledger-name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .ledger-main h3 a:hover,
  .ledger-main .ledger-name a:hover {
    border-bottom-color: var(--stamp);
  }
  .ledger-sub {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .ledger-side {
    text-align: right;
    flex-shrink: 0;
  }
  .ledger-price {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ledger-price .cents {
    font-size: 0.72em;
    color: var(--ink-muted);
  }
  .ledger-unit-note {
    margin: 0.2rem 0 0;
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--warn);
    background: var(--warn-bg);
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
    display: inline-block;
  }
  .ledger-price-old {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    text-decoration: line-through;
    margin-left: 0.35rem;
  }
  .ledger-stock {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }
  .ledger-stock.ok {
    color: var(--deal-dark);
  }
  .ledger-stock.danger {
    color: var(--stamp-dark);
  }
  .ledger-stock.muted {
    color: var(--ink-muted);
  }
  .ledger-cta {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--paper-raised);
    background: var(--ink);
    padding: 0.32rem 0.65rem;
    border-radius: 3px;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .ledger-cta:hover {
    background: var(--stamp-dark);
  }

  /* stamp badge: precio más bajo / mejor oferta */
  .stamp-badge {
    position: absolute;
    top: -0.55rem;
    left: 0.6rem;
    background: var(--deal);
    color: var(--paper-raised);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    transform: rotate(-2deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .stamp-badge {
      animation: stamp-impact 260ms var(--ease-print) backwards;
    }
  }
  @keyframes stamp-impact {
    0% {
      opacity: 0;
      transform: scale(1.5) rotate(-8deg);
    }
    60% {
      opacity: 1;
      transform: scale(0.94) rotate(-1deg);
    }
    100% {
      transform: scale(1) rotate(-2deg);
    }
  }

  /* perforación entre secciones */
  .tear {
    height: 1px;
    margin: 1.75rem 0;
    background-image: radial-gradient(circle, var(--ink-muted) 1px, transparent 1.2px);
    background-size: 9px 1px;
    background-repeat: repeat-x;
    opacity: 0.35;
  }

  /* estados de texto */
  .status {
    color: var(--ink-muted);
    text-align: center;
    padding: 1.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .status.error {
    color: var(--stamp-dark);
  }

  /* entrada "impresa" por fila, activada con la clase .is-printing vía JS/scroll */
  @media (prefers-reduced-motion: no-preference) {
    .ledger-row.print-in {
      animation: print-in 320ms var(--ease-print) backwards;
    }
  }
  @keyframes print-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* números tipo odómetro: los dígitos entran deslizándose hacia arriba y
     recortados, como una rueda mecánica que se detiene en su lugar, en vez
     de un simple fundido. */
  .odometer {
    display: inline-block;
    overflow: hidden;
    line-height: 1.15;
  }
  @media (prefers-reduced-motion: no-preference) {
    .odometer.roll-in {
      animation: odometer-roll 480ms var(--ease-print) backwards;
    }
  }
  @keyframes odometer-roll {
    0% {
      opacity: 0;
      transform: translateY(65%);
    }
    55% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
