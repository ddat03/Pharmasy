---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas."
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">💊 Farma Precios Ecuador</a>
    </header>
    <div class="disclaimer">
      Información referencial de precios. No constituye consejo médico.
      Consulte a su médico o farmacéutico.
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Datos recopilados de Fybeca, Pharmacys, Medicity, Cruz Azul y
        Farmacias Económicas. Proyecto independiente, sin afiliación con
        ninguna cadena.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --accent: #1d6fd6;
    --accent-dark: #14509e;
    --bg: #f7f9fc;
    --card-bg: #ffffff;
    --text: #1a1f27;
    --muted: #5b6472;
    --border: #e2e6ec;
    --danger: #b3261e;
    --danger-bg: #fdecea;
    --ok: #1f7a3f;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  .site-header {
    background: var(--accent);
    padding: 1rem 1.25rem;
  }
  .brand {
    color: #fff;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .disclaimer {
    background: #fff8e1;
    color: #7a5b00;
    font-size: 0.82rem;
    padding: 0.5rem 1.25rem;
    text-align: center;
    border-bottom: 1px solid #f0e0a0;
  }
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .site-footer {
    text-align: center;
    color: var(--muted);
    font-size: 0.8rem;
    padding: 2rem 1rem;
  }
</style>
