---
interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = "Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas.",
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Farma Precios Ecuador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_EC" />
    <meta name="twitter:card" content="summary" />

    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }

    <!--
      Slot de anuncios (Google AdSense) — preparado, sin activar todavía.
      Cuando exista una cuenta AdSense aprobada:
        1. Agregar el script de verificación del sitio en <head>:
           <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>
        2. Crear public/ads.txt con la línea que da AdSense
           (google.com, pub-XXXXXXXXXX, DIRECT, f08c47fec0942fa0).
        3. Descomentar los <ins class="adsbygoogle"> donde corresponda
           (ver comentarios "AD SLOT" en index.astro y medicamento/[slug].astro).
      Ver Boveda Farmacia/Conceptos/Monetización.
    -->
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">💊 Farma Precios Ecuador</a>
    </header>
    <div class="disclaimer">
      Información referencial de precios. No constituye consejo médico.
      Consulte a su médico o farmacéutico.
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Datos recopilados de Fybeca, Pharmacys, Medicity, Cruz Azul y
        Farmacias Económicas. Proyecto independiente, sin afiliación con
        ninguna cadena.
      </p>
      <p><a href="/politica-de-privacidad">Política de privacidad</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --accent: #1d6fd6;
    --accent-dark: #14509e;
    --bg: #f7f9fc;
    --card-bg: #ffffff;
    --text: #1a1f27;
    --muted: #5b6472;
    --border: #e2e6ec;
    --danger: #b3261e;
    --danger-bg: #fdecea;
    --ok: #1f7a3f;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  .site-header {
    background: var(--accent);
    padding: 1rem 1.25rem;
  }
  .brand {
    color: #fff;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .disclaimer {
    background: #fff8e1;
    color: #7a5b00;
    font-size: 0.82rem;
    padding: 0.5rem 1.25rem;
    text-align: center;
    border-bottom: 1px solid #f0e0a0;
  }
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .site-footer {
    text-align: center;
    color: var(--muted);
    font-size: 0.8rem;
    padding: 2rem 1rem;
  }
  .site-footer a {
    color: var(--muted);
  }
</style>
