---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";

import { getResumen, formatFechaLarga } from "../lib/supabase";
import { CATEGORIAS } from "../lib/categorias";

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = "Compara precios de medicamentos en Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. El precio tal cual aparece en cada tienda, sin cálculos.",
  structuredData,
} = Astro.props;

// La fecha del dato vive en el header de todas las paginas: es lo que
// separa un precio verificable de un numero cualquiera. Si la consulta
// falla, el header simplemente no la muestra — nunca se inventa una fecha.
// getResumen() esta cacheado a nivel de modulo: se consulta una vez por
// build, no una vez por cada una de las 1231 paginas.
const resumen = await getResumen().catch(() => ({ fecha: null, productosHoy: null, conPrecioTecho: null }));
const ultimaActualizacion = resumen.fecha;

// La franja superior decia "2,875 productos comparados" y "137 con precio
// techo oficial verificado" con los numeros escritos a mano en el codigo.
// Eran ciertos el dia que se escribieron y dejaron de serlo despues: una
// cifra fija sobre datos que cambian todas las noches es una afirmacion
// falsa esperando su turno. Ahora salen de la base, y el dato que no se
// pueda confirmar simplemente no se muestra.
const hechos = [
  resumen.productosHoy != null ? `${resumen.productosHoy.toLocaleString("es-EC")} precios verificados hoy` : null,
  resumen.conPrecioTecho != null ? `${resumen.conPrecioTecho} con precio techo oficial` : null,
  "5 cadenas de farmacia, un solo lugar",
  "nunca inventamos ni calculamos precios",
].filter((h): h is string => h !== null);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// El buscador del encabezado no se repite en la home, donde el campo grande
// del hero ya es el elemento principal de la pagina.
const esHome = Astro.url.pathname === "/";
---

<!--
  THESIS: Un comparador de precios se siente como una factura ecuatoriana, no
  como un panel de SaaS azul — porque el producto ya promete lo mismo que una
  factura promete (esto es exactamente lo que se cobra, verificable, nunca
  inventado), y la categoría siempre envía tarjetas redondeadas con
  degradado azul o el opuesto clínico blanco-hospital; ninguno de los dos.
  OWN-WORLD: papel crema (#F7F3EA), tinta casi negra, un acento tipo tinta de
  sello (#A6362A); IBM Plex Sans/Mono; filas de libro mayor con reglas finas
  en vez de tarjetas; el precio techo oficial vive en su propia línea de
  "impuesto/regulación" — separada del ledger por una perforación, como una
  sección aparte de la misma factura — nunca mezclado con el precio de la
  farmacia ni sumado a la tabla que sí se compara entre farmacias.
  STORY: el visitante entiende que esto lee precios reales de 5 farmacias
  como leería una factura — exacto, verificable — y encuentra el más barato
  sin que el sitio le calcule ni le sugiera nada.
  FIRST VIEWPORT: buscador arriba con rótulos tipo encabezado de factura;
  los resultados se "imprimen" como filas de un ticket a medida que llegan.
  FORM: La Factura — mi candidato #1 (de 7), elegido directamente por el
  usuario tras ver la dirección asignada por dado (letrero neón, candidato
  #6) y pedir el pick real. Sin seed key (el catálogo de retadores de
  impeccable no fue alcanzable desde esta sesión — ver PRODUCT.md).
  FINISH: unreviewed and undocumented is unfinished; this build ends with
  the finish review, the verdict, and DESIGN.md.
-->
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Farma Precios Ecuador" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!--
      Slot de anuncios (Google AdSense) — preparado, sin activar todavía.
      Cuando exista una cuenta AdSense aprobada:
        1. Agregar el script de verificación del sitio en <head>:
           <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>
        2. Crear public/ads.txt con la línea que da AdSense
           (google.com, pub-XXXXXXXXXX, DIRECT, f08c47fec0942fa0).
        3. Descomentar los <ins class="adsbygoogle"> donde corresponda
           (ver comentarios "AD SLOT" en index.astro y medicamento/[slug].astro).
      Ver Boveda Farmacia/Conceptos/Monetización.
    -->
  </head>
  <body>
    <header class="site-header">
      <div class="header-bar">
        <a class="brand" href="/">
          <span class="brand-word">Farma Precios</span>
          <span class="brand-stamp">EC</span>
        </a>

        {
          !esHome && (
            <form class="header-search" action="/" method="get" role="search">
              <label class="sr-only" for="header-q">
                Buscar medicamento
              </label>
              <input id="header-q" type="search" name="q" placeholder="Buscar medicamento..." autocomplete="off" />
              <button type="submit">Buscar</button>
            </form>
          )
        }

      </div>

      <nav class="cat-nav" aria-label="Categorías">
        <ul>
          {
            CATEGORIAS.map((c) => (
              <li>
                <a href={`/categoria/${c.slug}`}>{c.nombre}</a>
              </li>
            ))
          }
          <li class="nav-aparte">
            <a href="/marcas/">Marcas</a>
          </li>
        </ul>
      </nav>
    </header>

    <div class="disclaimer">
      <span>Información referencial de precios. No constituye consejo médico. Consulte a su médico o farmacéutico.</span>
    </div>

    <main>
      <slot />
    </main>

    {/* La franja de hechos cierra la pagina. Estaba arriba de todo, donde
        competia con la banda de marca por ser lo primero que se ve: dos
        elementos peleando por el mismo trabajo. Abajo cumple mejor su
        funcion, que es dejar el dato de cierre. */}
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {
          Array.from({ length: 2 }).map(() => (
            <>
              {hechos.map((hecho) => (
                <>
                  <span>{hecho}</span>
                  <span class="ticker-dot">·</span>
                </>
              ))}
            </>
          ))
        }
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-perf" aria-hidden="true"></div>
      <p>
        Datos recopilados de Fybeca, Pharmacys, Medicity, Cruz Azul y Farmacias Económicas. Proyecto independiente,
        sin afiliación con ninguna cadena.
      </p>
      {
        ultimaActualizacion && (
          <p class="footer-fecha">Precios actualizados el {formatFechaLarga(ultimaActualizacion)}.</p>
        )
      }
      <p class="footer-links">
        <a href="/acerca/">Cómo funciona</a>
        <a href="/contacto/">Contacto</a>
        <a href="/politica-de-privacidad/">Política de privacidad</a>
      </p>
      <p class="footer-sign"><a href="mailto:diegodavi0312@gmail.com">diegodavi0312@gmail.com</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f3ea;
    --paper-edge: #e8e0cc;
    --paper-raised: #fffdf7;
    --ink: #17160f;
    /* #746b57 sobre el papel daba 4.0:1 — por debajo del minimo legible para
       texto normal. Este mismo matiz, mas oscuro, llega a 5.9:1 sin salirse
       del mundo de tinta sobre papel. */
    --ink-muted: #57503f;
    --ink-faint: rgba(23, 22, 15, 0.2);
    --ink-faint-2: rgba(23, 22, 15, 0.08);
    --stamp: #a6362a;
    --stamp-dark: #7c271e;
    --stamp-bg: #f3e2df;
    --deal: #2f6b4f;
    --deal-dark: #1f4d38;
    --deal-bg: #e3ede6;
    --warn: #6b4a15;
    --warn-bg: #f3e9d4;
    --shadow-sm: 0 1px 2px rgba(28, 27, 24, 0.09);
    --font-sans:
      "IBM Plex Sans", system-ui, sans-serif;
    --font-mono:
      "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
    --ease-print: cubic-bezier(0.16, 1, 0.3, 1);
    /* El sitio ocupaba ~68% de una pantalla de 1440 y se leia como una
       columna de periodico. Es un comparador: la pantalla ancha es la
       ventaja, porque deja ver mas filas y mas columnas de un vistazo.
       La medida de lectura se sigue cuidando por bloque de prosa
       (.prose, 62ch), no encogiendo la pagina entera. */
    --page-w: 1320px;
  }

  /* En un monitor de 1920 el tope de 1320px volvia a dejar la pagina en
     ~69% de la pantalla. Un segundo escalon la lleva a ~78% sin que las
     filas del comparador se estiren tanto que dejen de leerse de un
     vistazo. */
  @media (min-width: 1700px) {
    :root {
      --page-w: 1500px;
    }
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: var(--stamp);
    color: var(--paper-raised);
  }

  html {
    scrollbar-color: var(--ink-muted) var(--paper);
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }

  /* ---------- ticker: franja de hechos reales, en movimiento continuo ---------- */
  .ticker {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    white-space: nowrap;
    padding: 0.45rem 0;
  }
  .ticker-track {
    display: inline-flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .ticker-dot {
    color: var(--stamp);
    margin: 0 0.35rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      width: max-content;
      animation: ticker-scroll 32s linear infinite;
    }
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- franja de marca ----------
     El encabezado y el pie son una banda solida de tinta de sello, con la
     marca en papel encima. Es lo que hace que la pagina tenga un color
     propio en vez de leerse como un documento neutro: el crema y la tinta
     siguen mandando en el contenido, que es donde la legibilidad importa,
     pero la identidad vive en los bordes. */
  .site-header {
    background: var(--stamp);
    color: var(--paper);
  }
  .header-bar {
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 0.95rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand-word {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
  }
  .brand-stamp {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--paper);
    border: 1.5px solid rgba(255, 253, 247, 0.65);
    border-radius: 3px;
    padding: 0.1rem 0.32rem;
    transform: rotate(-3deg);
  }

  /* Buscador de encabezado: sin el, alguien que llega a una pagina de
     medicamento desde Google no tiene forma de buscar otra cosa. */
  .header-search {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex: 1 1 260px;
    max-width: 420px;
    background: var(--paper-raised);
    border-radius: 3px;
    overflow: hidden;
  }
  .header-search input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0.42rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--ink);
    outline: none;
  }
  .header-search input::placeholder {
    color: var(--ink-muted);
    opacity: 0.8;
  }
  .header-search input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .header-search button {
    border: none;
    background: var(--ink);
    color: var(--paper-raised);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0 0.85rem;
    cursor: pointer;
  }
  .header-search button:hover {
    background: var(--stamp-dark);
  }

  /* Segunda linea de la banda, mas oscura: el menu de categorias, presente
     en todas las paginas. */
  .cat-nav {
    background: var(--stamp-dark);
  }
  .cat-nav ul {
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 0 1.5rem;
    list-style: none;
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cat-nav ul::-webkit-scrollbar {
    display: none;
  }
  /* "Marcas" no es una categoría terapéutica: se separa con una regla para
     que no se lea como una más de la lista. */
  .nav-aparte {
    border-left: 1px solid rgba(255, 253, 247, 0.3);
    padding-left: 1.25rem;
    margin-left: -0.25rem;
  }
  .cat-nav a {
    display: block;
    padding: 0.55rem 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(255, 253, 247, 0.88);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .cat-nav a:hover {
    color: var(--paper-raised);
    border-bottom-color: var(--paper-raised);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .disclaimer {
    background: var(--warn-bg);
    color: var(--warn);
    font-size: 0.78rem;
    border-top: 1px solid var(--ink-faint);
    border-bottom: 1px solid var(--ink-faint);
  }
  .disclaimer > span {
    display: block;
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 0.55rem 1.5rem;
  }

  main {
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
  }

  /* `.col` ya no reduce el ancho: existe solo como agrupador semantico
     heredado de las paginas. La medida de lectura se limita por bloque de
     prosa (.prose), no encogiendo la pagina entera — las filas del libro
     mayor se leen mejor anchas, con el precio anclado al borde derecho. */
  .col {
    max-width: 100%;
  }

  /* Medida de lectura para parrafos de prosa: ~68 caracteres. */
  .prose {
    max-width: 62ch;
  }

  /* ---------- footer ---------- */
  .site-footer {
    background: var(--stamp);
    color: rgba(255, 253, 247, 0.85);
    font-size: 0.78rem;
  }
  .site-footer > p,
  .site-footer > .footer-perf {
    max-width: var(--page-w);
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  .site-footer > p:first-of-type {
    padding-top: 2rem;
  }
  .site-footer > p:last-of-type {
    padding-bottom: 2.25rem;
  }
  .footer-perf {
    display: none;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .footer-fecha {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 253, 247, 0.78);
  }
  .footer-sign {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: rgba(255, 253, 247, 0.78);
  }
  .site-footer a {
    color: var(--paper-raised);
    text-decoration: underline;
    text-decoration-color: rgba(255, 253, 247, 0.4);
    text-underline-offset: 3px;
  }

  /* ---------- ledger: fila de resultado compartida entre buscador / medicamento / principio activo ---------- */
  .ledger {
    display: flex;
    flex-direction: column;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--ink-faint);
    position: relative;
  }
  .ledger-row:first-child {
    border-top: 1px solid var(--ink-faint);
  }
  .ledger-row.is-cheapest {
    background: linear-gradient(90deg, var(--deal-bg), transparent 60%);
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    border-radius: 3px;
  }
  .ledger-mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-faint);
    background: var(--paper-raised);
    padding: 5px;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .ledger-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .ledger-main {
    min-width: 0;
  }
  .ledger-main h3,
  .ledger-main .ledger-name {
    margin: 0 0 0.15rem;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: break-word;
  }
  .ledger-main h3 a,
  .ledger-main .ledger-name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .ledger-main h3 a:hover,
  .ledger-main .ledger-name a:hover {
    border-bottom-color: var(--stamp);
  }
  .ledger-sub {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .ledger-side {
    text-align: right;
    flex-shrink: 0;
  }
  .ledger-price {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ledger-price .cents {
    font-size: 0.72em;
    color: var(--ink-muted);
  }
  .ledger-unit-note {
    margin: 0.2rem 0 0;
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--warn);
    background: var(--warn-bg);
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
    display: inline-block;
  }
  .ledger-price-old {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    text-decoration: line-through;
    margin-left: 0.35rem;
  }
  .ledger-stock {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }
  .ledger-stock.ok {
    color: var(--deal-dark);
  }
  .ledger-stock.danger {
    color: var(--stamp-dark);
  }
  .ledger-stock.muted {
    color: var(--ink-muted);
  }
  .ledger-cta {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--paper-raised);
    background: var(--ink);
    padding: 0.32rem 0.65rem;
    border-radius: 3px;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .ledger-cta:hover {
    background: var(--stamp-dark);
  }

  /* En pantalla angosta la fila de tres columnas se rompe: `.ledger-main`
     tiene min-width 0 y puede encogerse hasta cero, mientras la columna del
     precio (auto = ancho del contenido) se queda con todo el espacio. El
     resultado medido a 390px era `34px 0px 279px`: el nombre del producto
     colapsado y partido una letra por linea.
     Debajo de 620px la fila se apila — marca y nombre arriba, precio y boton
     abajo — que ademas es como se leen las listas de producto en movil. */
  @media (max-width: 620px) {
    .ledger-row {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "mark main"
        "side side";
      row-gap: 0.6rem;
    }
    .ledger-mark {
      grid-area: mark;
    }
    .ledger-main {
      grid-area: main;
    }
    .ledger-side {
      grid-area: side;
      text-align: left;
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.35rem 0.7rem;
    }
    .ledger-side .ledger-price {
      order: -1;
    }
    .ledger-cta {
      margin-top: 0;
      margin-left: auto;
    }
  }

  /* stamp badge: precio más bajo / mejor oferta */
  .stamp-badge {
    position: absolute;
    top: -0.55rem;
    left: 0.6rem;
    background: var(--deal);
